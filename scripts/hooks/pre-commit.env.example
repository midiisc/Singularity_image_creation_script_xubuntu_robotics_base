# Copy this file to `.git/hooks/pre-commit.env` to configure
# environment variables consumed by the git pre-commit hook.
# The hook script sources that file on every `git commit`.
#
# Ensure AI review is enabled by default.
SKIP_AI_REVIEW=0

# ============================================================================
# PRIMARY PROVIDER: Anthropic (Claude) - REQUIRED
# ============================================================================
# Get your API key from: https://console.anthropic.com/
export AI_REVIEW_TOKEN="sk-ant-your-anthropic-api-key"
export AI_REVIEW_API_URL="https://api.anthropic.com/v1/messages"
export AI_REVIEW_PROVIDER="anthropic"

# Valid model names (use specific version dates, NOT "latest"):
# - claude-3-opus-20240229 (most capable, recommended)
# - claude-3-sonnet-20240229 (balanced)
# - claude-3-haiku-20240307 (fastest, cheapest)
export AI_REVIEW_MODEL="claude-3-opus-20240229"

# ============================================================================
# SECONDARY PROVIDER: OpenAI (optional) - For simple chunks
# ============================================================================
# Option 1: Use OpenAI as secondary provider
# export AI_REVIEW_SECONDARY_PROVIDER="openai"
# export AI_REVIEW_SECONDARY_TOKEN="sk-your-openai-key"
# export AI_REVIEW_SECONDARY_API_URL="https://api.openai.com/v1/chat/completions"
# export AI_REVIEW_SECONDARY_MODEL="gpt-4.1-mini"

# Option 2: Disable secondary provider (recommended - simpler setup)
export AI_REVIEW_SECONDARY_PROVIDER="none"

# ============================================================================
# ADVANCED CONFIGURATION (optional)
# ============================================================================
# export AI_REVIEW_MAX_TOKENS=2048
# export AI_REVIEW_SECONDARY_MAX_TOKENS=1024
# export AI_REVIEW_TIMEOUT=60
# export AI_REVIEW_MAX_LINES=400
# export AI_REVIEW_DISABLE_CACHE=0



#!/bin/bash
################################################################################
# PRE-COMMIT HOOK: COMPREHENSIVE VALIDATION
# Purpose: Run all validation checks before committing
# Installation:
#   ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#
# Implements:
#   - D4: Sed character class escaping validation
#   - M8/M9/M10: CMake flag validation
################################################################################

set -euo pipefail

# Configuration
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
WORKSPACE_ROOT=$(cd "${SCRIPT_DIR}/../.." 2>/dev/null && pwd || cd "${SCRIPT_DIR}" && pwd)

# Validators
SED_VALIDATOR="${WORKSPACE_ROOT}/scripts/helpers/validate_sed_patterns.sh"
CMAKE_VALIDATOR="${WORKSPACE_ROOT}/scripts/helpers/validate_cmake_flags.sh"

# Build scripts to check
BUILD_SCRIPTS=(
  "xubuntu_robotics_base_post_ULTRA_CLEANED.sh"
  "build_xubuntu_robotics_base.sh"
  "config.sh"
)

# Color codes
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly NC='\033[0m'

echo ""
echo -e "${CYAN}╔════════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║           PRE-COMMIT VALIDATION SUITE                          ║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if any build scripts are being committed
SCRIPTS_TO_VALIDATE=()
for script in "${BUILD_SCRIPTS[@]}"; do
  if echo "$STAGED_FILES" | grep -q "^${script}$"; then
    SCRIPTS_TO_VALIDATE+=("${script}")
  fi
done

# If no build scripts staged, skip validation
if [ ${#SCRIPTS_TO_VALIDATE[@]} -eq 0 ]; then
  echo -e "${GREEN}[✓]${NC} No build scripts staged for commit"
  echo -e "${GREEN}[✓]${NC} Skipping validation checks"
  echo ""
  exit 0
fi

echo -e "${BLUE}[INFO]${NC} Staged build scripts:"
for script in "${SCRIPTS_TO_VALIDATE[@]}"; do
  echo -e "       - ${script}"
done
echo ""

VALIDATION_FAILED=false
VALIDATORS_RUN=0

################################################################################
# VALIDATOR 1: Sed Pattern Validation (D4)
################################################################################

if [ -x "$SED_VALIDATOR" ]; then
  VALIDATORS_RUN=$((VALIDATORS_RUN + 1))
  echo -e "${CYAN}╭────────────────────────────────────────────────────────────────╮${NC}"
  echo -e "${CYAN}│  VALIDATOR 1/2: Sed Character Class Escaping (D4)             │${NC}"
  echo -e "${CYAN}╰────────────────────────────────────────────────────────────────╯${NC}"
  echo ""
  
  for script in "${SCRIPTS_TO_VALIDATE[@]}"; do
    script_path="${WORKSPACE_ROOT}/${script}"
    
    if [ ! -f "$script_path" ]; then
      echo -e "${YELLOW}[⚠]${NC} File not found: ${script}"
      continue
    fi
    
    # Run validator in warn mode (don't fail on warnings)
    if ! "$SED_VALIDATOR" "$script_path" --warn; then
      VALIDATION_FAILED=true
    fi
  done
else
  echo -e "${YELLOW}[⚠]${NC} Sed pattern validator not found: ${SED_VALIDATOR}"
  echo -e "${YELLOW}[⚠]${NC} Skipping sed validation"
  echo ""
fi

################################################################################
# VALIDATOR 2: CMake Flag Validation (M8/M9/M10)
################################################################################

if [ -x "$CMAKE_VALIDATOR" ]; then
  VALIDATORS_RUN=$((VALIDATORS_RUN + 1))
  echo -e "${CYAN}╭────────────────────────────────────────────────────────────────╮${NC}"
  echo -e "${CYAN}│  VALIDATOR 2/2: CMake Flag Documentation (M8/M9/M10)          │${NC}"
  echo -e "${CYAN}╰────────────────────────────────────────────────────────────────╯${NC}"
  echo ""
  
  for script in "${SCRIPTS_TO_VALIDATE[@]}"; do
    script_path="${WORKSPACE_ROOT}/${script}"
    
    if [ ! -f "$script_path" ]; then
      continue
    fi
    
    echo -e "${BLUE}[→]${NC} Validating: ${script}"
    echo ""
    
    if ! "$CMAKE_VALIDATOR" "$script_path" --strict; then
      VALIDATION_FAILED=true
      echo -e "${RED}[✗]${NC} CMake validation failed for: ${script}"
      echo ""
    else
      echo -e "${GREEN}[✓]${NC} CMake validation passed for: ${script}"
      echo ""
    fi
  done
else
  echo -e "${YELLOW}[⚠]${NC} CMake validator not found: ${CMAKE_VALIDATOR}"
  echo -e "${YELLOW}[⚠]${NC} Skipping CMake validation"
  echo ""
fi

################################################################################
# FINAL VERDICT
################################################################################

echo ""
echo -e "${CYAN}╔════════════════════════════════════════════════════════════════╗${NC}"

if [ "$VALIDATION_FAILED" = true ]; then
  echo -e "${CYAN}║${RED}  ✗ COMMIT BLOCKED: Validation Errors Detected                 ${CYAN}║${NC}"
  echo -e "${CYAN}╚════════════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${RED}VALIDATION FAILED${NC}"
  echo ""
  echo -e "${YELLOW}REQUIRED ACTIONS:${NC}"
  echo "  1. Review validation errors above"
  echo "  2. Fix reported issues in build scripts"
  echo "  3. Run 'git commit' again after fixes"
  echo ""
  echo -e "${YELLOW}TO BYPASS (NOT RECOMMENDED):${NC}"
  echo "  git commit --no-verify"
  echo ""
  echo -e "${YELLOW}REFERENCE:${NC}"
  echo "  - Sed patterns: prompts/Code_check_prompt_manual.txt (D4)"
  echo "  - CMake flags: prompts/Code_check_prompt_manual.txt (M8/M9/M10)"
  echo ""
  exit 1
else
  echo -e "${CYAN}║${GREEN}  ✓ ALL VALIDATIONS PASSED                                      ${CYAN}║${NC}"
  echo -e "${CYAN}╚════════════════════════════════════════════════════════════════╝${NC}"
  echo ""
  
  if [ $VALIDATORS_RUN -eq 0 ]; then
    echo -e "${YELLOW}[⚠]${NC} No validators were executed"
    echo -e "${YELLOW}[⚠]${NC} Proceeding with commit, but validation may be incomplete"
    echo ""
  else
    echo -e "${GREEN}[✓]${NC} Executed ${VALIDATORS_RUN} validator(s) successfully"
    echo -e "${GREEN}[✓]${NC} Build scripts are ready to commit"
    echo ""
  fi
  
  exit 0
fi

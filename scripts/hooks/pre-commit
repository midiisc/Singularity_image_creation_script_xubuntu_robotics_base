#!/bin/bash
################################################################################
# PRE-COMMIT HOOK: COMPREHENSIVE VALIDATION WITH AUTO-FIX
# Purpose: Validate and automatically fix issues before committing
# Installation:
#   ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#
# Features:
#   - Automatic detection of sed pattern errors (D4)
#   - Automatic fixing of malformed patterns
#   - Auto-staging of fixed files
#   - Re-validation after fixes
#   - CMake flag validation (M8/M9/M10)
#   - Zero human intervention required
#
# Flow:
#   1. Detect issues → 2. Auto-fix → 3. Re-stage → 4. Re-validate → 5. Commit
################################################################################

set -euo pipefail

# Configuration
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
WORKSPACE_ROOT=$(cd "${SCRIPT_DIR}/../.." 2>/dev/null && pwd || cd "${SCRIPT_DIR}" && pwd)

# Validators and fixers
SED_VALIDATOR="${WORKSPACE_ROOT}/scripts/helpers/validate_sed_patterns.sh"
SED_AUTO_FIX="${WORKSPACE_ROOT}/scripts/helpers/auto_fix_sed_patterns.sh"
CMAKE_VALIDATOR="${WORKSPACE_ROOT}/scripts/helpers/validate_cmake_flags.sh"

# Build scripts to check
BUILD_SCRIPTS=(
  "xubuntu_robotics_base_post_ULTRA_CLEANED.sh"
  "build_xubuntu_robotics_base.sh"
  "config.sh"
)

# Color codes
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly MAGENTA='\033[0;35m'
readonly NC='\033[0m'

# Auto-fix configuration
MAX_FIX_ATTEMPTS=3
FIX_ATTEMPT=0

echo ""
echo -e "${CYAN}╔════════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║    PRE-COMMIT: AUTOMATED VALIDATION & FIX SYSTEM              ║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if any build scripts are being committed
SCRIPTS_TO_VALIDATE=()
for script in "${BUILD_SCRIPTS[@]}"; do
  if echo "$STAGED_FILES" | grep -q "^${script}$"; then
    SCRIPTS_TO_VALIDATE+=("${script}")
  fi
done

# If no build scripts staged, skip validation
if [ ${#SCRIPTS_TO_VALIDATE[@]} -eq 0 ]; then
  echo -e "${GREEN}[✓]${NC} No build scripts staged for commit"
  echo -e "${GREEN}[✓]${NC} Proceeding with commit"
  echo ""
  exit 0
fi

echo -e "${BLUE}[INFO]${NC} Staged build scripts:"
for script in "${SCRIPTS_TO_VALIDATE[@]}"; do
  echo -e "       - ${script}"
done
echo ""

################################################################################
# AUTO-FIX LOOP
################################################################################

run_validation_and_fix_loop() {
  local script_path="$1"
  local script_name=$(basename "$script_path")
  
  echo -e "${CYAN}╭────────────────────────────────────────────────────────────────╮${NC}"
  echo -e "${CYAN}│  PROCESSING: ${script_name}${NC}"
  echo -e "${CYAN}╰────────────────────────────────────────────────────────────────╯${NC}"
  echo ""
  
  local fix_loop_active=true
  local loop_iteration=0
  
  while [ "$fix_loop_active" = true ] && [ $loop_iteration -lt $MAX_FIX_ATTEMPTS ]; do
    loop_iteration=$((loop_iteration + 1))
    
    if [ $loop_iteration -gt 1 ]; then
      echo -e "${MAGENTA}[RETRY $loop_iteration/$MAX_FIX_ATTEMPTS]${NC} Re-running validation after fixes..."
      echo ""
    fi
    
    ############################################################################
    # STEP 1: Run sed pattern validation
    ############################################################################
    
    if [ -x "$SED_VALIDATOR" ]; then
      echo -e "${BLUE}[VALIDATOR]${NC} Checking sed patterns..."
      echo ""
      
      if "$SED_VALIDATOR" "$script_path" --warn; then
        echo -e "${GREEN}[✓]${NC} Sed pattern validation: PASSED"
        echo ""
        fix_loop_active=false
        return 0
      else
        # Validation failed - attempt auto-fix
        echo -e "${YELLOW}[⚠]${NC} Sed pattern validation: FAILED"
        echo ""
        
        if [ -x "$SED_AUTO_FIX" ]; then
          echo -e "${MAGENTA}[AUTO-FIX]${NC} Attempting to fix issues automatically..."
          echo ""
          
          if "$SED_AUTO_FIX" "$script_path"; then
            echo -e "${GREEN}[✓]${NC} Auto-fix: Corrections applied successfully"
            echo ""
            
            # Re-stage the fixed file
            echo -e "${BLUE}[GIT]${NC} Re-staging fixed file..."
            git add "$script_path"
            echo -e "${GREEN}[✓]${NC} File re-staged: ${script_name}"
            echo ""
            
            # Loop will continue to re-validate
            echo -e "${MAGENTA}[LOOP]${NC} Re-validating to confirm fixes..."
            echo ""
          else
            # Auto-fix reported no fixes needed
            echo -e "${GREEN}[✓]${NC} No fixes needed (warnings only)"
            echo ""
            fix_loop_active=false
            return 0
          fi
        else
          echo -e "${RED}[✗]${NC} Auto-fix script not found: ${SED_AUTO_FIX}"
          echo -e "${RED}[✗]${NC} Cannot auto-fix issues"
          return 1
        fi
      fi
    else
      echo -e "${YELLOW}[⚠]${NC} Sed validator not found, skipping validation"
      echo ""
      fix_loop_active=false
      return 0
    fi
  done
  
  # If we exited the loop due to max attempts
  if [ $loop_iteration -ge $MAX_FIX_ATTEMPTS ]; then
    echo -e "${RED}[✗]${NC} Max fix attempts ($MAX_FIX_ATTEMPTS) reached"
    echo -e "${RED}[✗]${NC} Unable to automatically resolve all issues"
    echo ""
    return 1
  fi
  
  return 0
}

################################################################################
# PROCESS ALL STAGED SCRIPTS
################################################################################

VALIDATION_FAILED=false
TOTAL_FIXES_APPLIED=0

for script in "${SCRIPTS_TO_VALIDATE[@]}"; do
  script_path="${WORKSPACE_ROOT}/${script}"
  
  if [ ! -f "$script_path" ]; then
    echo -e "${YELLOW}[⚠]${NC} File not found: ${script}"
    continue
  fi
  
  if ! run_validation_and_fix_loop "$script_path"; then
    VALIDATION_FAILED=true
  fi
done

################################################################################
# CMAKE VALIDATION (No auto-fix yet)
################################################################################

if [ -x "$CMAKE_VALIDATOR" ]; then
  echo -e "${CYAN}╭────────────────────────────────────────────────────────────────╮${NC}"
  echo -e "${CYAN}│  CMAKE FLAG VALIDATION (M8/M9/M10)                             │${NC}"
  echo -e "${CYAN}╰────────────────────────────────────────────────────────────────╯${NC}"
  echo ""
  
  for script in "${SCRIPTS_TO_VALIDATE[@]}"; do
    script_path="${WORKSPACE_ROOT}/${script}"
    
    if [ ! -f "$script_path" ]; then
      continue
    fi
    
    echo -e "${BLUE}[→]${NC} Validating: ${script}"
    echo ""
    
    if ! "$CMAKE_VALIDATOR" "$script_path" --strict; then
      VALIDATION_FAILED=true
      echo -e "${RED}[✗]${NC} CMake validation failed for: ${script}"
      echo -e "${YELLOW}[NOTE]${NC} CMake issues require manual review"
      echo ""
    else
      echo -e "${GREEN}[✓]${NC} CMake validation passed for: ${script}"
      echo ""
    fi
  done
fi

################################################################################
# FINAL VERDICT
################################################################################

echo ""
echo -e "${CYAN}╔════════════════════════════════════════════════════════════════╗${NC}"

if [ "$VALIDATION_FAILED" = true ]; then
  echo -e "${CYAN}║${RED}  ✗ COMMIT BLOCKED: Unresolved Validation Errors               ${CYAN}║${NC}"
  echo -e "${CYAN}╚════════════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${RED}[FAILED]${NC} Unable to automatically resolve all issues"
  echo ""
  echo -e "${YELLOW}[SUMMARY]${NC}"
  echo "  - Sed pattern issues were attempted to auto-fix"
  echo "  - CMake issues require manual review"
  echo "  - Some issues could not be automatically resolved"
  echo ""
  echo -e "${YELLOW}[ACTIONS REQUIRED]${NC}"
  echo "  1. Review validation errors above"
  echo "  2. Manually fix remaining issues"
  echo "  3. Stage fixes: git add <files>"
  echo "  4. Re-run: git commit"
  echo ""
  echo -e "${YELLOW}[TO BYPASS]${NC} (not recommended):"
  echo "  git commit --no-verify"
  echo ""
  echo -e "${YELLOW}[REFERENCE]${NC}"
  echo "  - Sed patterns: prompts/Code_check_prompt_manual.txt (D4)"
  echo "  - CMake flags: prompts/Code_check_prompt_manual.txt (M8/M9/M10)"
  echo ""
  exit 1
else
  echo -e "${CYAN}║${GREEN}  ✓ ALL VALIDATIONS PASSED - AUTO-FIX SUCCESSFUL                ${CYAN}║${NC}"
  echo -e "${CYAN}╚════════════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${GREEN}[SUCCESS]${NC} All issues resolved automatically"
  echo ""
  echo -e "${BLUE}[SUMMARY]${NC}"
  echo "  - Sed pattern validation: PASSED"
  echo "  - All malformed patterns: AUTO-FIXED"
  echo "  - All missing fallbacks: AUTO-ADDED"
  echo "  - Fixed files: AUTO-STAGED"
  echo "  - Ready to commit: YES"
  echo ""
  echo -e "${GREEN}[✓]${NC} Proceeding with commit..."
  echo ""
  exit 0
fi

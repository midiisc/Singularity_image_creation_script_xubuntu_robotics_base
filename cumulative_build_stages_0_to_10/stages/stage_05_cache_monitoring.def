# CRITICAL: CUMULATIVE BUILD - Stage 5 builds on Stage 4
# This stage includes ALL cumulative steps from:
#   - Stage 0: Minimal base (bind mounts, essential tools)
#   - Stage 1: Bootstrap safe environment (APT robustness, directory structure, procps-ng)
#   - Stage 2: Terminal colors and Block 0 (container scripts installation)
#   - Stage 3: Initialization blocks (phase tracking, debug functions, build jobs)
#   - Stage 4: Cache and mirror functions (cache management, mirror probing, library verification)
#   - Stage 5: Cache monitoring and configuration (cache monitoring system, unified cache configuration)
# 
# Stage 5 MUST be built on top of Stage 4 for cumulative build
# Using absolute path to ensure Stage 4 image is found
Bootstrap: localimage
From: /home/midhun/Documents/Singularity_image_creation_script_xubuntu_robotics_base/test_local_mounts/progressive/output/stage_04_cache_mirror.sif

# === %files Section ===
%files
    # CRITICAL: Copy centralized configuration (SINGLE SOURCE OF TRUTH)
    /home/midhun/Documents/Singularity_image_creation_script_xubuntu_robotics_base/config.sh /etc/config.sh
    # Copy container scripts (already installed in Stage 2, but ensure they're available)
    /home/midhun/Documents/Singularity_image_creation_script_xubuntu_robotics_base/container-scripts /container-scripts
    # Copy common functions (needed for cache management functions)
    /home/midhun/Documents/Singularity_image_creation_script_xubuntu_robotics_base/scripts/common_functions.sh /scripts/common_functions.sh
    # Copy mirror functions (needed for mirror probing)
    /home/midhun/Documents/Singularity_image_creation_script_xubuntu_robotics_base/scripts/mirror_functions.sh /scripts/mirror_functions.sh
    # Copy library functions (needed for library verification)
    /home/midhun/Documents/Singularity_image_creation_script_xubuntu_robotics_base/scripts/library_functions.sh /scripts/library_functions.sh
    # Copy cache functions (needed for cache monitoring and configuration)
    /home/midhun/Documents/Singularity_image_creation_script_xubuntu_robotics_base/scripts/cache_functions.sh /scripts/cache_functions.sh

# === %labels Section ===
%labels
    Maintainer midhun
    Description "Progressive Stage 5: Cache Monitoring and Configuration (Cache Monitoring System, Unified Cache Configuration)"

# === %environment Section ===
%environment
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Asia/Kolkata
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    
    # Terminal color codes (from Stage 2) - simple exports only
    export RED='\033[0;31m'
    export GREEN='\033[0;32m'
    export YELLOW='\033[1;33m'
    export BLUE='\033[0;34m'
    export NC='\033[0m'
    
    # Phase tracking variables (from Stage 3) - simple exports only
    export PHASE1_STATUS="NOT RUN"
    export PHASE2_STATUS="NOT RUN"
    export PHASE3_STATUS="NOT RUN"
    export PHASE4_STATUS="NOT RUN"
    export PHASE5_STATUS="NOT RUN"
    
    # Cache configuration variables (from Stage 5) - simple exports only
    # Note: These use hardcoded paths since config.sh is not available in %environment
    # The actual values will be set from config.sh in %post section
    export CACHE_ROOT="/container_cache"
    export PIP_CACHE_DIR="/container_cache/wheels"
    export CONDA_PKGS_DIRS="/container_cache/conda_pkgs"
    export JULIA_DEPOT_PATH="/container_cache/julia_pkgs:/usr/local/share/julia"

# === %setup Section ===
%setup
    # Create mount point directories (using /container_cache as default - config.sh available in %post)
    mkdir -p ${APPTAINER_ROOTFS}/container_cache
    mkdir -p ${APPTAINER_ROOTFS}/tmp
    mkdir -p ${APPTAINER_ROOTFS}/var/tmp
    mkdir -p ${APPTAINER_ROOTFS}/scripts
    # CRITICAL: Ensure .singularity.d directory exists for metadata (required when building from localimage)
    mkdir -p ${APPTAINER_ROOTFS}/.singularity.d

# === %post Section ===
%post -c /bin/bash
    # CRITICAL: Ensure .singularity.d directory exists for metadata (required when building from localimage)
    # This must be done early in %post before any metadata operations
    mkdir -p /.singularity.d
    mkdir -p /.singularity.d/actions
    mkdir -p /.singularity.d/env
    mkdir -p /.singularity.d/libs
    chmod -R 755 /.singularity.d 2>/dev/null || true
    touch /.singularity.d/.keep 2>/dev/null || true
    chmod 755 /.singularity.d 2>/dev/null || true
    # CRITICAL: Set non-interactive environment variables FIRST
    export DEBIAN_FRONTEND=noninteractive
    export DEBCONF_NONINTERACTIVE_SEEN=true
    export DEBCONF_NOWARNINGS=true
    
    # === CRITICAL: Source centralized configuration ===
    # config.sh is the SINGLE SOURCE OF TRUTH for all paths, versions, and settings
    # It is copied to /etc/config.sh in the %files section
    if [ -f /etc/config.sh ]; then
        # Disable strict mode temporarily to allow config.sh to set defaults
        set +u
        source /etc/config.sh
        set -u
        printf '%s\n' "[%post] ✓ Loaded centralized configuration from /etc/config.sh"
    else
        printf '%s\n' "[%post] ⚠ WARNING: /etc/config.sh not found - using defaults"
        printf '%s\n' "[%post]   This should not happen - config.sh should be copied in %files section"
        # Set minimal defaults if config.sh missing
        export CONTAINER_CACHE_ROOT="${CONTAINER_CACHE_ROOT:-/container_cache}"
        export INSTALL_PREFIX="${INSTALL_PREFIX:-/opt}"
    fi
    
    # === CRITICAL: Set terminal color codes FIRST (before any usage) ===
    # Purpose: Define color codes for terminal output (needed for all output sections)
    # Dependencies: None (foundational - must be set before use)
    # Outputs: Environment variables for colored output
    export RED='\033[0;31m'
    export GREEN='\033[0;32m'
    export YELLOW='\033[1;33m'
    export BLUE='\033[0;34m'
    export NC='\033[0m'
    
    printf '%s\n' "=========================================="
    printf '%s\n' "PROGRESSIVE STAGE 5: Cache Monitoring and Configuration"
    printf '%s\n' "=========================================="
    printf '%s\n' ""
    printf '%s\n' "[CUMULATIVE BUILD] Stage 5 includes ALL cumulative steps from:"
    printf '%s\n' "  - Stage 0: Minimal base (bind mounts, essential tools) - INCLUDED"
    printf '%s\n' "  - Stage 1: Bootstrap safe environment (APT robustness, directory structure, procps-ng) - INCLUDED"
    printf '%s\n' "  - Stage 2: Terminal colors and Block 0 (container scripts installation) - INCLUDED"
    printf '%s\n' "  - Stage 3: Initialization blocks (phase tracking, debug functions, build jobs) - INCLUDED"
    printf '%s\n' "  - Stage 4: Cache and mirror functions (cache management, mirror probing, library verification) - INCLUDED"
    printf '%s\n' "  - Stage 5: Cache monitoring and configuration (cache monitoring system, unified cache configuration) - NEW"
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 0: MINIMAL BASE - ALL STEPS INCLUDED
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 0: Installing Essential Tools${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # CRITICAL: Ensure APT directories are writable BEFORE any apt-get operations
    printf '%s\n' "[STAGE 0] Verifying APT writability (CRITICAL for build)..."
    APT_WRITABILITY_FAILED=0
    for apt_dir in /var/lib/apt/lists /var/lib/apt/lists/partial /var/cache/apt/archives /var/cache/apt/archives/partial /etc/apt/sources.list.d /etc/apt/trusted.gpg.d /etc/apt/preferences.d /etc/apt/apt.conf.d; do
        # Create directory if it doesn't exist
        mkdir -p "${apt_dir}" 2>/dev/null || true
        # Set permissions
        chmod 755 "${apt_dir}" 2>/dev/null || true
        # Test writability
        if [ -d "${apt_dir}" ]; then
            if touch "${apt_dir}/.write_test_$$" 2>/dev/null; then
                rm -f "${apt_dir}/.write_test_$$" 2>/dev/null || true
                printf '%s\n' "  ✓ ${apt_dir} is writable"
            else
                printf '%s\n' "  ⚠ ${apt_dir} not writable - attempting to fix..."
                chown -R root:root "${apt_dir}" 2>/dev/null || true
                chmod -R 755 "${apt_dir}" 2>/dev/null || true
                if touch "${apt_dir}/.write_test_$$" 2>/dev/null; then
                    rm -f "${apt_dir}/.write_test_$$" 2>/dev/null || true
                    printf '%s\n' "  ✓ ${apt_dir} is now writable (fixed)"
                else
                    printf '%s\n' "  ✗ ${apt_dir} is NOT writable - APT operations will fail"
                    APT_WRITABILITY_FAILED=$((APT_WRITABILITY_FAILED + 1))
                fi
            fi
        fi
    done
    if [ ${APT_WRITABILITY_FAILED} -gt 0 ]; then
        printf '%s\n' "  ✗ FATAL: ${APT_WRITABILITY_FAILED} APT directory(ies) not writable - cannot proceed with build"
        exit 1
    else
        printf '%s\n' "  ✓ All APT directories verified writable"
    fi
    printf '%s\n' ""
    
    printf '%s\n' "[STAGE 0] Installing essential tools..."
    apt-get update -qq >/dev/null 2>&1 || true
    
    # Essential download and network tools
    if ! apt-get install -y --no-install-recommends \
        wget \
        curl \
        gpg-agent \
        ca-certificates \
        gnupg \
        gnupg2 \
        >/dev/null 2>&1; then
        printf '%s\n' "  ✗ Failed to install essential download tools"
        exit 1
    fi
    printf '%s\n' "  ✓ Essential download tools installed"
    
    # Essential system tools
    if ! apt-get install -y --no-install-recommends \
        procps \
        file \
        less \
        >/dev/null 2>&1; then
        printf '%s\n' "  ✗ Failed to install essential system tools"
        exit 1
    fi
    printf '%s\n' "  ✓ Essential system tools installed"
    
    # Try procps-ng if procps didn't provide pgrep
    if ! command -v pgrep >/dev/null 2>&1; then
        apt-get install -y --no-install-recommends procps-ng >/dev/null 2>&1 || true
    fi
    
    # Essential package inspection tools
    if ! apt-get install -y --no-install-recommends dpkg-dev >/dev/null 2>&1; then
        printf '%s\n' "  ✗ Failed to install dpkg-dev"
        exit 1
    fi
    printf '%s\n' "  ✓ Package inspection tools installed"
    
    # Essential archive and compression tools
    if ! apt-get install -y --no-install-recommends \
        tar \
        gzip \
        bzip2 \
        xz-utils \
        unzip \
        >/dev/null 2>&1; then
        printf '%s\n' "  ✗ Failed to install archive tools"
        exit 1
    fi
    printf '%s\n' "  ✓ Archive tools installed"
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 1: BOOTSTRAP SAFE ENVIRONMENT - ALL STEPS INCLUDED
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 1: Bootstrap Safe Environment${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Find safe temp directory
    printf '%s\n' "[STAGE 1] Finding safe temp directory..."
    SAFE_TMP=""
    if touch /tmp/.test_$$ 2>/dev/null; then
        rm /tmp/.test_$$ 2>/dev/null || true
        SAFE_TMP="/tmp"
        printf '%s\n' "  ✓ Found writable temp dir: ${SAFE_TMP}"
    else
        for candidate in "/var/tmp" "/opt/tmp" "/usr/local/tmp" "/home/root/tmp"; do
            if mkdir -p "${candidate}" 2>/dev/null && touch "${candidate}/.test_$$" 2>/dev/null; then
                rm "${candidate}/.test_$$" 2>/dev/null || true
                SAFE_TMP="${candidate}"
                printf '%s\n' "  ✓ Found writable temp dir: ${SAFE_TMP} (fallback)"
                break
            fi
        done
    fi
    
    if [ -z "${SAFE_TMP}" ]; then
        printf '%s\n' "  ✗ FATAL: Could not find ANY writable directory for temporary files"
        exit 1
    fi
    
    export TMPDIR="${SAFE_TMP}"
    export TEMP="${SAFE_TMP}"
    export TMP="${SAFE_TMP}"
    
    # Install tool shims
    printf '%s\n' "[STAGE 1] Installing tool shims..."
    if [ -f /usr/bin/gpg ] && [ ! -f /usr/bin/gpg.real ]; then
        mv /usr/bin/gpg /usr/bin/gpg.real
        printf '#!/bin/sh\nexport TMPDIR="%s"\nexport TEMP="%s"\nexport TMP="%s"\nexec /usr/bin/gpg.real "$@"\n' "${SAFE_TMP}" "${SAFE_TMP}" "${SAFE_TMP}" > /usr/bin/gpg
        chmod 755 /usr/bin/gpg
        printf '%s\n' "  ✓ Shimmed: gpg"
    fi
    
    if [ -f /usr/bin/apt-key ] && [ ! -f /usr/bin/apt-key.real ]; then
        mv /usr/bin/apt-key /usr/bin/apt-key.real
        printf '#!/bin/sh\nexport TMPDIR="%s"\nexec /usr/bin/apt-key.real "$@"\n' "${SAFE_TMP}" > /usr/bin/apt-key
        chmod 755 /usr/bin/apt-key
        printf '%s\n' "  ✓ Shimmed: apt-key"
    fi
    
    if [ -f /usr/bin/mktemp ] && [ ! -f /usr/bin/mktemp.real ]; then
        mv /usr/bin/mktemp /usr/bin/mktemp.real
        printf '#!/bin/sh\nexport TMPDIR="%s"\nexec /usr/bin/mktemp.real "$@"\n' "${SAFE_TMP}" > /usr/bin/mktemp
        chmod 755 /usr/bin/mktemp
        printf '%s\n' "  ✓ Shimmed: mktemp"
    fi
    
    # APT temp configuration
    mkdir -p /etc/apt/apt.conf.d
    echo "Acquire::TempDir \"${SAFE_TMP}\";" > /etc/apt/apt.conf.d/00-safe-temp
    printf '%s\n' "  ✓ Configured APT Acquire::TempDir to ${SAFE_TMP}"
    
    # APT robustness configuration
    printf '%s\n' "[STAGE 1] Configuring APT robustness..."
    mkdir -p "${CONTAINER_APT_CACHE:-${CONTAINER_CACHE_ROOT:-/container_cache}/apt/archives}" 2>/dev/null || true
    mkdir -p "${CONTAINER_APT_CACHE:-${CONTAINER_CACHE_ROOT:-/container_cache}/apt/archives}/partial" 2>/dev/null || true
    
    {
        echo "# APT robustness configuration"
        echo "Acquire::Check-Valid-Until false;"
        echo "Acquire::Retries \"3\";"
        echo "Acquire::http::Timeout \"20\";"
        echo "Dir::Cache::Archives \"${CONTAINER_APT_CACHE:-${CONTAINER_CACHE_ROOT:-/container_cache}/apt/archives}\";"
        echo "APT::Keep-Downloaded-Packages \"true\";"
    } > /etc/apt/apt.conf.d/01-robustness
    printf '%s\n' "  ✓ APT robustness configuration created"
    
    # Create directory structure
    printf '%s\n' "[STAGE 1] Creating directory structure..."
    for dir in /var/lib/apt/lists /var/lib/apt/lists/partial /var/cache/apt/archives /var/cache/apt/archives/partial /etc/apt/sources.list.d /etc/apt/trusted.gpg.d /etc/apt/preferences.d /etc/apt/apt.conf.d; do
        mkdir -p "${dir}" 2>/dev/null || true
        chmod 755 "${dir}" 2>/dev/null || true
        # CRITICAL: Ensure writability during build
        if [ -d "${dir}" ]; then
            # Test writability by creating a test file
            if touch "${dir}/.write_test_$$" 2>/dev/null; then
                rm -f "${dir}/.write_test_$$" 2>/dev/null || true
                printf '%s\n' "  ✓ ${dir} is writable"
            else
                printf '%s\n' "  ⚠ ${dir} may not be writable - attempting to fix..."
                # Try to fix ownership and permissions
                chown -R root:root "${dir}" 2>/dev/null || true
                chmod -R 755 "${dir}" 2>/dev/null || true
                # Test again
                if touch "${dir}/.write_test_$$" 2>/dev/null; then
                    rm -f "${dir}/.write_test_$$" 2>/dev/null || true
                    printf '%s\n' "  ✓ ${dir} is now writable (fixed)"
                else
                    printf '%s\n' "  ✗ ${dir} is NOT writable - this may cause APT failures during build"
                    exit 1
                fi
            fi
        fi
    done
    printf '%s\n' "  ✓ Directory structure created and verified writable"
    
    # Install procps-ng unconditionally
    printf '%s\n' "[STAGE 1] Installing procps-ng..."
    apt-get install -y --no-install-recommends procps 2>&1 || true
    apt-get install -y --no-install-recommends procps-ng 2>&1 || true
    printf '%s\n' "  ✓ procps-ng installation attempted"
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 2: TERMINAL COLORS AND CONTAINER SCRIPTS - ALL STEPS INCLUDED
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 2: Terminal Colors and Container Scripts${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Terminal color codes (already set above, but verify)
    printf '%s\n' "[STAGE 2] Verifying terminal color codes..."
    COLOR_VERIFY_FAILED=0
    for color_var in RED GREEN YELLOW BLUE NC; do
        if [ -z "${!color_var:-}" ]; then
            printf '%s\n' "  ✗ ${color_var} not defined"
            COLOR_VERIFY_FAILED=$((COLOR_VERIFY_FAILED + 1))
        fi
    done
    if [ ${COLOR_VERIFY_FAILED} -eq 0 ]; then
        printf '%s\n' "  ✓ All terminal color codes defined"
    fi
    
    # Container scripts installation
    printf '%s\n' "[STAGE 2] Installing container scripts..."
    CONTAINER_SCRIPTS_PATH="${CONTAINER_SCRIPTS_INSTALL_PATH:-/container-scripts}"
    INSTALLER_SCRIPT="${CONTAINER_SCRIPTS_PATH}/install.sh"
    
    if [ -d "${CONTAINER_SCRIPTS_PATH}" ] && [ -f "${INSTALLER_SCRIPT}" ]; then
        chmod +x "${INSTALLER_SCRIPT}" 2>/dev/null || true
        if "${INSTALLER_SCRIPT}" --all 2>&1; then
            printf '%s\n' "  ✓ Container scripts installed successfully"
        else
            printf '%s\n' "  ⚠ Container scripts installation had issues (may already be installed)"
        fi
    else
        printf '%s\n' "  ⚠ Container scripts directory not found (may be from %files section)"
    fi
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 3: INITIALIZATION BLOCKS - ALL STEPS INCLUDED
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 3: Initialization Blocks${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Phase tracking variables
    printf '%s\n' "[STAGE 3] Setting up phase tracking variables..."
    export PHASE1_STATUS="NOT RUN"
    export PHASE2_STATUS="NOT RUN"
    export PHASE3_STATUS="NOT RUN"
    export PHASE4_STATUS="NOT RUN"
    export PHASE5_STATUS="NOT RUN"
    printf '%s\n' "  ✓ Phase tracking variables set"
    
    # Environment setup
    printf '%s\n' "[STAGE 3] Setting up environment..."
    export DEBIAN_FRONTEND=noninteractive
    printf '%s\n' "  ✓ Environment setup complete"
    
    # Load common functions
    printf '%s\n' "[STAGE 3] Loading common functions..."
    if [ -f /scripts/common_functions.sh ]; then
        set +u
        source /scripts/common_functions.sh 2>/dev/null || true
        set -u
        if command -v calculate_build_jobs >/dev/null 2>&1; then
            BUILD_JOBS=$(calculate_build_jobs 2>&1 || echo "8")
            export BUILD_JOBS
            printf '%s\n' "  ✓ calculate_build_jobs() loaded (returns: ${BUILD_JOBS})"
        else
            printf '%s\n' "  ⚠ calculate_build_jobs() not available"
        fi
    else
        printf '%s\n' "  ⚠ common_functions.sh not found (will be loaded later)"
    fi
    
    # Define debug_glibc() function (from Stage 3)
    printf '%s\n' "[STAGE 3] Defining debug_glibc() function..."
    debug_glibc() {
        local stage="$1"
        local __prev_opts="$-"
        local __had_e=0
        case "$__prev_opts" in *e*) __had_e=1 ;; esac
        set +e
        set +o pipefail 2>/dev/null || true
        printf '%s\n' "=========================================================="
        printf '%b\n' "${BLUE}DEBUG CHECKPOINT: ${stage}${NC}"
        printf '%s\n' "Time: $(date)"
        printf '%s\n' "=========================================================="
        /lib/x86_64-linux-gnu/libc.so.6 2>/dev/null | head -1 2>/dev/null || true
        printf '%s\n' "---"
        (timeout 5 sh -c 'ldd --version 2>&1' || true) | head -1 || true
        printf '%s\n' "---"
        gcc --version 2>/dev/null | head -1 2>/dev/null || printf '%s\n' "GCC not installed yet" || true
        printf '%s\n' "---"
        find /usr/include -name "stdlib.h" 2>/dev/null || printf '%s\n' "stdlib.h not found"
        printf '%s\n' "---"
        printf '\033[0m\n'
        set -o pipefail 2>/dev/null || true
        if [ "$__had_e" -eq 1 ]; then
            set -e
        fi
    }
    export -f debug_glibc
    printf '%s\n' "  ✓ debug_glibc() function defined"
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 4: CACHE AND MIRROR FUNCTIONS - NEW STEPS
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 4: Cache and Mirror Functions${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # === SOURCE FUNCTION SCRIPTS ===
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}LOADING FUNCTION SCRIPTS${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Source common functions (cache management functions)
    if [ -f /scripts/common_functions.sh ]; then
        printf '%s\n' "[LOAD] Sourcing common_functions.sh..."
        if source /scripts/common_functions.sh 2>/dev/null; then
            printf '%s\n' "  ✓ common_functions.sh loaded successfully"
        else
            printf '%s\n' "  ✗ Failed to load common_functions.sh"
            exit 1
        fi
    else
        printf '%s\n' "  ✗ common_functions.sh not found"
        exit 1
    fi
    
    # Source mirror functions
    if [ -f /scripts/mirror_functions.sh ]; then
        printf '%s\n' "[LOAD] Sourcing mirror_functions.sh..."
        if source /scripts/mirror_functions.sh 2>/dev/null; then
            printf '%s\n' "  ✓ mirror_functions.sh loaded successfully"
        else
            printf '%s\n' "  ✗ Failed to load mirror_functions.sh"
            exit 1
        fi
    else
        printf '%s\n' "  ✗ mirror_functions.sh not found"
        exit 1
    fi
    
    # Source library functions
    if [ -f /scripts/library_functions.sh ]; then
        printf '%s\n' "[LOAD] Sourcing library_functions.sh..."
        if source /scripts/library_functions.sh 2>/dev/null; then
            printf '%s\n' "  ✓ library_functions.sh loaded successfully"
        else
            printf '%s\n' "  ✗ Failed to load library_functions.sh"
            exit 1
        fi
    else
        printf '%s\n' "  ✗ library_functions.sh not found"
        exit 1
    fi
    printf '%s\n' ""
    
    # === VERIFY ALL FUNCTIONS ARE DEFINED ===
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}FUNCTION VERIFICATION${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    FUNCTION_VERIFY_FAILED=0
    
    # Verify cache management functions (from common_functions.sh)
    printf '%s\n' "[VERIFY] Cache management functions..."
    if declare -f consolidate_cache_packages >/dev/null 2>&1; then
        printf '%s\n' "  ✓ consolidate_cache_packages() is defined"
    else
        printf '%s\n' "  ✗ consolidate_cache_packages() is NOT defined"
        FUNCTION_VERIFY_FAILED=$((FUNCTION_VERIFY_FAILED + 1))
    fi
    if declare -f monitor_cache >/dev/null 2>&1; then
        printf '%s\n' "  ✓ monitor_cache() is defined"
    else
        printf '%s\n' "  ✗ monitor_cache() is NOT defined"
        FUNCTION_VERIFY_FAILED=$((FUNCTION_VERIFY_FAILED + 1))
    fi
    
    # Verify mirror functions (from mirror_functions.sh)
    printf '%s\n' "[VERIFY] Mirror probing functions..."
    if declare -f test_mirror >/dev/null 2>&1; then
        printf '%s\n' "  ✓ test_mirror() is defined"
    else
        printf '%s\n' "  ✗ test_mirror() is NOT defined"
        FUNCTION_VERIFY_FAILED=$((FUNCTION_VERIFY_FAILED + 1))
    fi
    if declare -f probe_and_set_mirrors >/dev/null 2>&1; then
        printf '%s\n' "  ✓ probe_and_set_mirrors() is defined"
    else
        printf '%s\n' "  ✗ probe_and_set_mirrors() is NOT defined"
        FUNCTION_VERIFY_FAILED=$((FUNCTION_VERIFY_FAILED + 1))
    fi
    
    # Verify library functions (from library_functions.sh)
    printf '%s\n' "[VERIFY] Library verification functions..."
    if declare -f verify_library_available >/dev/null 2>&1; then
        printf '%s\n' "  ✓ verify_library_available() is defined"
    else
        printf '%s\n' "  ✗ verify_library_available() is NOT defined"
        FUNCTION_VERIFY_FAILED=$((FUNCTION_VERIFY_FAILED + 1))
    fi
    # Also check alias
    if declare -f verify_library_installation >/dev/null 2>&1; then
        printf '%s\n' "  ✓ verify_library_installation() is defined (alias)"
    else
        printf '%s\n' "  ⚠ verify_library_installation() alias not found (using verify_library_available instead)"
    fi
    if declare -f run_ldconfig_refresh >/dev/null 2>&1; then
        printf '%s\n' "  ✓ run_ldconfig_refresh() is defined"
    else
        printf '%s\n' "  ✗ run_ldconfig_refresh() is NOT defined"
        FUNCTION_VERIFY_FAILED=$((FUNCTION_VERIFY_FAILED + 1))
    fi
    if declare -f run_ldconfig_refresh_dir >/dev/null 2>&1; then
        printf '%s\n' "  ✓ run_ldconfig_refresh_dir() is defined"
    else
        printf '%s\n' "  ✗ run_ldconfig_refresh_dir() is NOT defined"
        FUNCTION_VERIFY_FAILED=$((FUNCTION_VERIFY_FAILED + 1))
    fi
    if declare -f ensure_library_path_registered >/dev/null 2>&1; then
        printf '%s\n' "  ✓ ensure_library_path_registered() is defined"
    else
        printf '%s\n' "  ✗ ensure_library_path_registered() is NOT defined"
        FUNCTION_VERIFY_FAILED=$((FUNCTION_VERIFY_FAILED + 1))
    fi
    if declare -f ensure_compiled_lib_priority >/dev/null 2>&1; then
        printf '%s\n' "  ✓ ensure_compiled_lib_priority() is defined"
    else
        printf '%s\n' "  ✗ ensure_compiled_lib_priority() is NOT defined"
        FUNCTION_VERIFY_FAILED=$((FUNCTION_VERIFY_FAILED + 1))
    fi
    
    if [ ${FUNCTION_VERIFY_FAILED} -gt 0 ]; then
        printf '%s\n' "  ✗ ${FUNCTION_VERIFY_FAILED} function verification(s) failed"
        exit 1
    else
        printf '%s\n' "  ✓ All functions verified and available"
    fi
    printf '%s\n' ""
    
    # === TEST FUNCTION EXECUTION ===
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}FUNCTION EXECUTION TESTS${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    EXECUTION_TEST_FAILED=0
    
    # Test cache management functions (should not fail even if cache is empty)
    printf '%s\n' "[TEST] Testing consolidate_cache_packages()..."
    if consolidate_cache_packages >/dev/null 2>&1; then
        printf '%s\n' "  ✓ consolidate_cache_packages() executed successfully"
    else
        printf '%s\n' "  ✗ consolidate_cache_packages() execution failed"
        EXECUTION_TEST_FAILED=$((EXECUTION_TEST_FAILED + 1))
    fi
    
    printf '%s\n' "[TEST] Testing monitor_cache()..."
    if monitor_cache "Stage 4 test" >/dev/null 2>&1; then
        printf '%s\n' "  ✓ monitor_cache() executed successfully"
    else
        printf '%s\n' "  ✗ monitor_cache() execution failed"
        EXECUTION_TEST_FAILED=$((EXECUTION_TEST_FAILED + 1))
    fi
    
    # Test library functions
    printf '%s\n' "[TEST] Testing run_ldconfig_refresh()..."
    if run_ldconfig_refresh >/dev/null 2>&1; then
        printf '%s\n' "  ✓ run_ldconfig_refresh() executed successfully"
    else
        printf '%s\n' "  ✗ run_ldconfig_refresh() execution failed"
        EXECUTION_TEST_FAILED=$((EXECUTION_TEST_FAILED + 1))
    fi
    
    printf '%s\n' "[TEST] Testing ensure_compiled_lib_priority()..."
    if ensure_compiled_lib_priority >/dev/null 2>&1; then
        printf '%s\n' "  ✓ ensure_compiled_lib_priority() executed successfully"
    else
        printf '%s\n' "  ✗ ensure_compiled_lib_priority() execution failed"
        EXECUTION_TEST_FAILED=$((EXECUTION_TEST_FAILED + 1))
    fi
    
    # Test library verification (test with a system library that should exist)
    printf '%s\n' "[TEST] Testing verify_library_available()..."
    if verify_library_available "libc.so" "/lib/x86_64-linux-gnu/libc.so.6" >/dev/null 2>&1; then
        printf '%s\n' "  ✓ verify_library_available() executed successfully (found libc.so)"
    else
        printf '%s\n' "  ⚠ verify_library_available() test inconclusive (libc.so may not be in expected location)"
        # Don't fail - this is just a test
    fi
    
    # Note: test_mirror() and probe_and_set_mirrors() require network access
    # We'll skip network tests in build (they can be tested at runtime)
    printf '%s\n' "[INFO] Skipping network-dependent tests (test_mirror, probe_and_set_mirrors) - will be tested at runtime"
    
    if [ ${EXECUTION_TEST_FAILED} -gt 0 ]; then
        printf '%s\n' "  ✗ ${EXECUTION_TEST_FAILED} execution test(s) failed"
        exit 1
    else
        printf '%s\n' "  ✓ All execution tests passed"
    fi
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 5: CACHE MONITORING AND CONFIGURATION - NEW STEPS
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 5: Cache Monitoring and Configuration${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # === BLOCK 5: CACHE MONITORING SYSTEM ===
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}BLOCK 5: Cache Monitoring System${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Sub-block 5.1: Initialize cache monitoring data file
    printf '%s\n' "[BLOCK 5.1] Initializing cache monitoring data file..."
    CACHE_MONITOR_DATA="/tmp/cache_monitor_data.txt"
    printf '%s\n' "Stage|Container APT|Var APT|Conda|Wheels|Julia" > "${CACHE_MONITOR_DATA}"
    export CACHE_MONITOR_DATA
    if [ -f "${CACHE_MONITOR_DATA}" ] && [ -w "${CACHE_MONITOR_DATA}" ]; then
        printf '%s\n' "  ✓ Cache monitoring data file created: ${CACHE_MONITOR_DATA}"
    else
        printf '%s\n' "  ✗ Failed to create cache monitoring data file"
        exit 1
    fi
    printf '%s\n' ""
    
    # Sub-block 5.2: Verify monitor_cache() function (already in common_functions.sh)
    printf '%s\n' "[BLOCK 5.2] Verifying monitor_cache() function..."
    if declare -f monitor_cache >/dev/null 2>&1; then
        printf '%s\n' "  ✓ monitor_cache() is available (from common_functions.sh)"
    else
        printf '%s\n' "  ✗ monitor_cache() is NOT available"
        exit 1
    fi
    printf '%s\n' ""
    
    # Source cache functions (contains display_cache_monitoring_summary and cache_summary)
    printf '%s\n' "[BLOCK 5.3-5.4] Loading cache monitoring functions..."
    if [ -f /scripts/cache_functions.sh ]; then
        set +u
        source /scripts/cache_functions.sh 2>/dev/null || true
        set -u
        if declare -f display_cache_monitoring_summary >/dev/null 2>&1 && declare -f cache_summary >/dev/null 2>&1; then
            printf '%s\n' "  ✓ cache_functions.sh loaded successfully"
            printf '%s\n' "  ✓ display_cache_monitoring_summary() is available"
            printf '%s\n' "  ✓ cache_summary() is available"
        else
            printf '%s\n' "  ✗ Failed to load cache monitoring functions"
            exit 1
        fi
    else
        printf '%s\n' "  ✗ cache_functions.sh not found"
        exit 1
    fi
    printf '%s\n' ""
    
    # === BLOCK 6: CACHE DIRECTORY CONFIGURATION ===
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}BLOCK 6: Cache Directory Configuration${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Sub-block 6.1: Define unified cache root
    printf '%s\n' "[BLOCK 6.1] Defining unified cache root..."
    CACHE_ROOT="${CONTAINER_CACHE_ROOT:-/container_cache}"
    export CACHE_ROOT
    printf '%s\n' "  ✓ CACHE_ROOT set to: ${CACHE_ROOT}"
    printf '%s\n' ""
    
    # Sub-block 6.2: Configure package manager cache paths
    printf '%s\n' "[BLOCK 6.2] Configuring package manager cache paths..."
    export PIP_CACHE_DIR="${CACHE_ROOT}/wheels"
    export CONDA_PKGS_DIRS="${CACHE_ROOT}/conda_pkgs"
    export JULIA_DEPOT_PATH="${CACHE_ROOT}/julia_pkgs:/usr/local/share/julia"
    printf '%s\n' "  ✓ PIP_CACHE_DIR set to: ${PIP_CACHE_DIR}"
    printf '%s\n' "  ✓ CONDA_PKGS_DIRS set to: ${CONDA_PKGS_DIRS}"
    printf '%s\n' "  ✓ JULIA_DEPOT_PATH set to: ${JULIA_DEPOT_PATH}"
    printf '%s\n' ""
    
    # Sub-block 6.3: Validate and repair cache (verify function is available)
    printf '%s\n' "[BLOCK 6.3] Verifying validate_and_repair_cache() function..."
    if declare -f validate_and_repair_cache >/dev/null 2>&1; then
        printf '%s\n' "  ✓ validate_and_repair_cache() is available (from cache_functions.sh)"
    else
        printf '%s\n' "  ✗ validate_and_repair_cache() is NOT available"
        exit 1
    fi
    printf '%s\n' ""
    
    # Sub-block 6.4: Setup unified cache (verify function is available and execute)
    printf '%s\n' "[BLOCK 6.4] Verifying and executing setup_unified_cache() function..."
    if declare -f setup_unified_cache >/dev/null 2>&1; then
        printf '%s\n' "  ✓ setup_unified_cache() is available (from cache_functions.sh)"
        printf '%s\n' "  Executing setup_unified_cache()..."
        if setup_unified_cache; then
            printf '%s\n' "  ✓ setup_unified_cache() executed successfully"
        else
            printf '%s\n' "  ✗ setup_unified_cache() execution failed"
            exit 1
        fi
    else
        printf '%s\n' "  ✗ setup_unified_cache() is NOT available"
        exit 1
    fi
    printf '%s\n' ""
    
    # === TEST CACHE MONITORING ===
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}CACHE MONITORING TESTS${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Test monitor_cache() with Stage 5
    printf '%s\n' "[TEST] Testing monitor_cache() with Stage 5..."
    if monitor_cache "Stage 5 test" >/dev/null 2>&1; then
        printf '%s\n' "  ✓ monitor_cache() executed successfully"
    else
        printf '%s\n' "  ✗ monitor_cache() execution failed"
        exit 1
    fi
    
    # Test display_cache_monitoring_summary()
    printf '%s\n' "[TEST] Testing display_cache_monitoring_summary()..."
    if display_cache_monitoring_summary >/dev/null 2>&1; then
        printf '%s\n' "  ✓ display_cache_monitoring_summary() executed successfully"
    else
        printf '%s\n' "  ✗ display_cache_monitoring_summary() execution failed"
        exit 1
    fi
    
    # Test cache_summary()
    printf '%s\n' "[TEST] Testing cache_summary()..."
    if cache_summary >/dev/null 2>&1; then
        printf '%s\n' "  ✓ cache_summary() executed successfully"
    else
        printf '%s\n' "  ✗ cache_summary() execution failed"
        exit 1
    fi
    printf '%s\n' ""
    
    # === FINAL SUMMARY ===
    printf '%s\n' "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${GREEN}STAGE 5 COMPLETE${NC}"
    printf '%s\n' "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    printf '%s\n' "✓ Cumulative verification: All previous stages verified"
    printf '%s\n' "✓ Function scripts loaded: common_functions.sh, mirror_functions.sh, library_functions.sh, cache_functions.sh"
    printf '%s\n' "✓ Cache monitoring system: CACHE_MONITOR_DATA initialized, all functions available"
    printf '%s\n' "✓ Cache directory configuration: Unified cache root and package manager paths configured"
    printf '%s\n' "✓ Unified cache setup: APT, pip, conda, and Julia caches configured"
    printf '%s\n' "✓ Execution tests passed: All cache monitoring and configuration functions execute successfully"
    printf '%s\n' ""
    printf '%s\n' "Stage 5 includes:"
    printf '%s\n' "  - Cache monitoring: CACHE_MONITOR_DATA, monitor_cache(), display_cache_monitoring_summary(), cache_summary()"
    printf '%s\n' "  - Cache configuration: CACHE_ROOT, PIP_CACHE_DIR, CONDA_PKKS_DIRS, JULIA_DEPOT_PATH"
    printf '%s\n' "  - Unified cache setup: validate_and_repair_cache(), setup_unified_cache()"
    printf '%s\n' ""
    
    # === CREATE RUNTIME INITIALIZATION SCRIPT ===
    # Purpose: Source function scripts and define functions at runtime
    # This script will be sourced automatically by bash when container starts
    printf '%s\n' "[RUNTIME INIT] Creating runtime initialization script..."
    mkdir -p /etc/profile.d
    {
        echo "#!/bin/bash"
        echo "# Runtime initialization script for Stage 5"
        echo "# This script sources all function scripts and defines functions"
        echo ""
        echo "# Source function scripts (from Stages 3, 4, and 5)"
        echo "if [ -f /scripts/common_functions.sh ]; then"
        echo "    . /scripts/common_functions.sh 2>/dev/null || true"
        echo "fi"
        echo "if [ -f /scripts/mirror_functions.sh ]; then"
        echo "    . /scripts/mirror_functions.sh 2>/dev/null || true"
        echo "fi"
        echo "if [ -f /scripts/library_functions.sh ]; then"
        echo "    . /scripts/library_functions.sh 2>/dev/null || true"
        echo "fi"
        echo "if [ -f /scripts/cache_functions.sh ]; then"
        echo "    . /scripts/cache_functions.sh 2>/dev/null || true"
        echo "fi"
        echo ""
        echo "# Define debug_glibc() function (from Stage 3)"
        echo "debug_glibc() {"
        echo "    local stage=\"\${1:-unknown}\""
        echo "    local __prev_opts=\"\$-\""
        echo "    local __had_e=0"
        echo "    case \"\$__prev_opts\" in *e*) __had_e=1 ;; esac"
        echo "    set +e"
        echo "    set +o pipefail 2>/dev/null || true"
        echo "    printf '%s\\n' '=========================================================='"
        echo "    printf '%b\\n' \"\${BLUE}DEBUG CHECKPOINT: \${stage}\${NC}\""
        echo "    printf '%s\\n' \"Time: \$(date)\""
        echo "    printf '%s\\n' '=========================================================='"
        echo "    /lib/x86_64-linux-gnu/libc.so.6 2>/dev/null | head -1 2>/dev/null || true"
        echo "    printf '%s\\n' '---'"
        echo "    (timeout 5 sh -c 'ldd --version 2>&1' || true) | head -1 || true"
        echo "    printf '%s\\n' '---'"
        echo "    gcc --version 2>/dev/null | head -1 2>/dev/null || printf '%s\\n' 'GCC not installed yet' || true"
        echo "    printf '%s\\n' '---'"
        echo "    find /usr/include -name 'stdlib.h' 2>/dev/null || printf '%s\\n' 'stdlib.h not found'"
        echo "    printf '%s\\n' '---'"
        echo "    printf '\\033[0m\\n'"
        echo "    set -o pipefail 2>/dev/null || true"
        echo "    if [ \"\$__had_e\" -eq 1 ]; then"
        echo "        set -e"
        echo "    fi"
        echo "}"
        echo "export -f debug_glibc"
    } > /etc/profile.d/stage5_init.sh
    chmod 644 /etc/profile.d/stage5_init.sh
    printf '%s\n' "  ✓ Runtime initialization script created: /etc/profile.d/stage5_init.sh"
    
    # Cleanup temporary files
    rm -rf /tmp/* /var/tmp/* 2>/dev/null || true


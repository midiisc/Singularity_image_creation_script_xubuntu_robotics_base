    printf '%s\n' "${BLUE}FUNCTION EXECUTION TESTS${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    EXECUTION_TEST_FAILED=0
    
    # Test cache management functions (should not fail even if cache is empty)
    printf '%s\n' "[TEST] Testing consolidate_cache_packages()..."
    if consolidate_cache_packages >/dev/null 2>&1; then
        printf '%s\n' "  ✓ consolidate_cache_packages() executed successfully"
    else
        printf '%s\n' "  ✗ consolidate_cache_packages() execution failed"
        EXECUTION_TEST_FAILED=$((EXECUTION_TEST_FAILED + 1))
    fi
    
    printf '%s\n' "[TEST] Testing monitor_cache()..."
    if monitor_cache "Stage 4 test" >/dev/null 2>&1; then
        printf '%s\n' "  ✓ monitor_cache() executed successfully"
    else
        printf '%s\n' "  ✗ monitor_cache() execution failed"
        EXECUTION_TEST_FAILED=$((EXECUTION_TEST_FAILED + 1))
    fi
    

# === %labels Section ===
%labels
    Maintainer midhun
    Description "Progressive Stage 9: APT-ARIA Wrapper Setup (BLOCK 11)"

# === %environment Section ===
%environment
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Asia/Kolkata
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    
    # Terminal color codes (from Stage 2) - simple exports only
    export RED='\033[0;31m'
    export GREEN='\033[0;32m'
    export YELLOW='\033[1;33m'
    export BLUE='\033[0;34m'
    export NC='\033[0m'
    
    # Phase tracking variables (from Stage 3) - simple exports only
    export PHASE1_STATUS="NOT RUN"
    export PHASE2_STATUS="NOT RUN"
    export PHASE3_STATUS="NOT RUN"
    export PHASE4_STATUS="NOT RUN"
    export PHASE5_STATUS="NOT RUN"
    
    # Cache configuration variables (from Stage 5) - simple exports only
    # Note: These use hardcoded paths since config.sh is not available in %environment
    # The actual values will be set from config.sh in %post section
    export CACHE_ROOT="/container_cache"
    export PIP_CACHE_DIR="/container_cache/wheels"
    export CONDA_PKGS_DIRS="/container_cache/conda_pkgs"
    export JULIA_DEPOT_PATH="/container_cache/julia_pkgs:/usr/local/share/julia"
    
    # Mirror configuration (from Stage 8) - will be set in %post
    export FASTEST_MIRROR=""

# === %setup Section ===
%setup
    # Create mount point directories (using /container_cache as default - config.sh available in %post)
    mkdir -p ${APPTAINER_ROOTFS}/container_cache
    mkdir -p ${APPTAINER_ROOTFS}/tmp
    mkdir -p ${APPTAINER_ROOTFS}/var/tmp
    mkdir -p ${APPTAINER_ROOTFS}/scripts

# === %post Section ===
%post -c /bin/bash
    # CRITICAL: Set non-interactive environment variables FIRST
    export DEBIAN_FRONTEND=noninteractive
    export DEBCONF_NONINTERACTIVE_SEEN=true
    export DEBCONF_NOWARNINGS=true
    
    # === CRITICAL: Source centralized configuration ===
    # config.sh is the SINGLE SOURCE OF TRUTH for all paths, versions, and settings
    # It is copied to /etc/config.sh in the %files section
    if [ -f /etc/config.sh ]; then
        # Disable strict mode temporarily to allow config.sh to set defaults
        set +u
        source /etc/config.sh
        set -u
        printf '%s\n' "[%post] ✓ Loaded centralized configuration from /etc/config.sh"
    else
        printf '%s\n' "[%post] ⚠ WARNING: /etc/config.sh not found - using defaults"
        printf '%s\n' "[%post]   This should not happen - config.sh should be copied in %files section"
        # Set minimal defaults if config.sh missing
        export CONTAINER_CACHE_ROOT="${CONTAINER_CACHE_ROOT:-/container_cache}"
        export INSTALL_PREFIX="${INSTALL_PREFIX:-/opt}"
    fi
    
    # === CRITICAL: Set terminal color codes FIRST (before any usage) ===
    # Purpose: Define color codes for terminal output (needed for all output sections)
    # Dependencies: None (foundational - must be set before use)
    # Outputs: Environment variables for colored output
    export RED='\033[0;31m'
    export GREEN='\033[0;32m'
    export YELLOW='\033[1;33m'
    export BLUE='\033[0;34m'
    export NC='\033[0m'
    
    printf '%s\n' "=========================================="
    printf '%s\n' "PROGRESSIVE STAGE 9: APT-ARIA Wrapper Setup"
    printf '%s\n' "=========================================="
    printf '%s\n' ""
    printf '%s\n' "[CUMULATIVE BUILD] Stage 7 includes ALL cumulative steps from:"
    printf '%s\n' "  - Stage 0: Minimal base (bind mounts, essential tools) - INCLUDED"
    printf '%s\n' "  - Stage 1: Bootstrap safe environment (APT robustness, directory structure, procps-ng) - INCLUDED"
    printf '%s\n' "  - Stage 2: Terminal colors and Block 0 (container scripts installation) - INCLUDED"
    printf '%s\n' "  - Stage 3: Initialization blocks (phase tracking, debug functions, build jobs) - INCLUDED"
    printf '%s\n' "  - Stage 4: Cache and mirror functions (cache management, mirror probing, library verification) - INCLUDED"
    printf '%s\n' "  - Stage 5: Cache monitoring and configuration (cache monitoring system, unified cache configuration) - INCLUDED"
    printf '%s\n' "  - Stage 6: Package management functions (advanced package management with staging, retry, atomicity, integrity, locking) - INCLUDED"
    printf '%s\n' "  - Stage 7: Main build execution start (cache directory structure, systematic writability enforcement) - INCLUDED"
    printf '%s\n' "  - Stage 8: Mirror selection and APT setup (BLOCK 9 and BLOCK 10) - INCLUDED"
    printf '%s\n' "  - Stage 9: APT-ARIA wrapper setup (BLOCK 11) - NEW"
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 0: MINIMAL BASE - ALL STEPS INCLUDED
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 0: Installing Essential Tools${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # CRITICAL: Ensure APT directories are writable BEFORE any apt-get operations
    printf '%s\n' "[STAGE 0] Verifying APT writability (CRITICAL for build)..."
    APT_WRITABILITY_FAILED=0
    for apt_dir in /var/lib/apt/lists /var/lib/apt/lists/partial /var/cache/apt/archives /var/cache/apt/archives/partial /etc/apt/sources.list.d /etc/apt/trusted.gpg.d /etc/apt/preferences.d /etc/apt/apt.conf.d; do
        # Create directory if it doesn't exist
        mkdir -p "${apt_dir}" 2>/dev/null || true
        # Set permissions
        chmod 755 "${apt_dir}" 2>/dev/null || true
        # Test writability
        if [ -d "${apt_dir}" ]; then
            if touch "${apt_dir}/.write_test_$$" 2>/dev/null; then
                rm -f "${apt_dir}/.write_test_$$" 2>/dev/null || true
                printf '%s\n' "  ✓ ${apt_dir} is writable"
            else
                printf '%s\n' "  ⚠ ${apt_dir} not writable - attempting to fix..."
                chown -R root:root "${apt_dir}" 2>/dev/null || true
                chmod -R 755 "${apt_dir}" 2>/dev/null || true
                if touch "${apt_dir}/.write_test_$$" 2>/dev/null; then
                    rm -f "${apt_dir}/.write_test_$$" 2>/dev/null || true
                    printf '%s\n' "  ✓ ${apt_dir} is now writable (fixed)"
                else
                    printf '%s\n' "  ✗ ${apt_dir} is NOT writable - APT operations will fail"
                    APT_WRITABILITY_FAILED=$((APT_WRITABILITY_FAILED + 1))
                fi
            fi
        fi
    done
    if [ ${APT_WRITABILITY_FAILED} -gt 0 ]; then
        printf '%s\n' "  ✗ FATAL: ${APT_WRITABILITY_FAILED} APT directory(ies) not writable - cannot proceed with build"
        exit 1
    else
        printf '%s\n' "  ✓ All APT directories verified writable"
    fi
    printf '%s\n' ""
    
    printf '%s\n' "[STAGE 0] Installing essential tools..."
    apt-get update -qq >/dev/null 2>&1 || true
    
    # Essential download and network tools
    if ! apt-get install -y --no-install-recommends \
        wget \
        curl \
        gpg-agent \
        ca-certificates \
        gnupg \
        gnupg2 \
        >/dev/null 2>&1; then
        printf '%s\n' "  ✗ Failed to install essential download tools"
        exit 1
    fi
    printf '%s\n' "  ✓ Essential download tools installed"
    
    # Essential system tools
    if ! apt-get install -y --no-install-recommends \
        procps \
        file \
        less \
        >/dev/null 2>&1; then
        printf '%s\n' "  ✗ Failed to install essential system tools"
        exit 1
    fi
    printf '%s\n' "  ✓ Essential system tools installed"
    
    # Try procps-ng if procps didn't provide pgrep
    if ! command -v pgrep >/dev/null 2>&1; then
        apt-get install -y --no-install-recommends procps-ng >/dev/null 2>&1 || true
    fi
    
    # Essential package inspection tools
    if ! apt-get install -y --no-install-recommends dpkg-dev >/dev/null 2>&1; then
        printf '%s\n' "  ✗ Failed to install dpkg-dev"
        exit 1
    fi
    printf '%s\n' "  ✓ Package inspection tools installed"
    
    # Essential archive and compression tools
    if ! apt-get install -y --no-install-recommends \
        tar \
        gzip \
        bzip2 \
        xz-utils \
        unzip \
        >/dev/null 2>&1; then
        printf '%s\n' "  ✗ Failed to install archive tools"
        exit 1
    fi
    printf '%s\n' "  ✓ Archive tools installed"
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 1: BOOTSTRAP SAFE ENVIRONMENT - ALL STEPS INCLUDED
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 1: Bootstrap Safe Environment${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Find safe temp directory
    printf '%s\n' "[STAGE 1] Finding safe temp directory..."
    SAFE_TMP=""
    if touch /tmp/.test_$$ 2>/dev/null; then
        rm /tmp/.test_$$ 2>/dev/null || true
        SAFE_TMP="/tmp"
        printf '%s\n' "  ✓ Found writable temp dir: ${SAFE_TMP}"
    else
        for candidate in "/var/tmp" "/opt/tmp" "/usr/local/tmp" "/home/root/tmp"; do
            if mkdir -p "${candidate}" 2>/dev/null && touch "${candidate}/.test_$$" 2>/dev/null; then
                rm "${candidate}/.test_$$" 2>/dev/null || true
                SAFE_TMP="${candidate}"
                printf '%s\n' "  ✓ Found writable temp dir: ${SAFE_TMP} (fallback)"
                break
            fi
        done
    fi
    
    if [ -z "${SAFE_TMP}" ]; then
        printf '%s\n' "  ✗ FATAL: Could not find ANY writable directory for temporary files"
        exit 1
    fi
    
    export TMPDIR="${SAFE_TMP}"
    export TEMP="${SAFE_TMP}"
    export TMP="${SAFE_TMP}"
    
    # Install tool shims
    printf '%s\n' "[STAGE 1] Installing tool shims..."
    if [ -f /usr/bin/gpg ] && [ ! -f /usr/bin/gpg.real ]; then
        mv /usr/bin/gpg /usr/bin/gpg.real
        printf '#!/bin/sh\nexport TMPDIR="%s"\nexport TEMP="%s"\nexport TMP="%s"\nexec /usr/bin/gpg.real "$@"\n' "${SAFE_TMP}" "${SAFE_TMP}" "${SAFE_TMP}" > /usr/bin/gpg
        chmod 755 /usr/bin/gpg
        printf '%s\n' "  ✓ Shimmed: gpg"
    fi
    
    if [ -f /usr/bin/apt-key ] && [ ! -f /usr/bin/apt-key.real ]; then
        mv /usr/bin/apt-key /usr/bin/apt-key.real
        printf '#!/bin/sh\nexport TMPDIR="%s"\nexec /usr/bin/apt-key.real "$@"\n' "${SAFE_TMP}" > /usr/bin/apt-key
        chmod 755 /usr/bin/apt-key
        printf '%s\n' "  ✓ Shimmed: apt-key"
    fi
    
    if [ -f /usr/bin/mktemp ] && [ ! -f /usr/bin/mktemp.real ]; then
        mv /usr/bin/mktemp /usr/bin/mktemp.real
        printf '#!/bin/sh\nexport TMPDIR="%s"\nexec /usr/bin/mktemp.real "$@"\n' "${SAFE_TMP}" > /usr/bin/mktemp
        chmod 755 /usr/bin/mktemp
        printf '%s\n' "  ✓ Shimmed: mktemp"
    fi
    
    # APT temp configuration
    mkdir -p /etc/apt/apt.conf.d
    echo "Acquire::TempDir \"${SAFE_TMP}\";" > /etc/apt/apt.conf.d/00-safe-temp
    printf '%s\n' "  ✓ Configured APT Acquire::TempDir to ${SAFE_TMP}"
    
    # APT robustness configuration
    printf '%s\n' "[STAGE 1] Configuring APT robustness..."
    mkdir -p "${CONTAINER_APT_CACHE:-${CONTAINER_CACHE_ROOT:-/container_cache}/apt/archives}" 2>/dev/null || true
    mkdir -p "${CONTAINER_APT_CACHE:-${CONTAINER_CACHE_ROOT:-/container_cache}/apt/archives}/partial" 2>/dev/null || true
    
    {
        echo "# APT robustness configuration"
        echo "Acquire::Check-Valid-Until false;"
        echo "Acquire::Retries \"3\";"
        echo "Acquire::http::Timeout \"20\";"
        echo "Dir::Cache::Archives \"${CONTAINER_APT_CACHE:-${CONTAINER_CACHE_ROOT:-/container_cache}/apt/archives}\";"
        echo "APT::Keep-Downloaded-Packages \"true\";"
    } > /etc/apt/apt.conf.d/01-robustness
    printf '%s\n' "  ✓ APT robustness configuration created"
    
    # Create directory structure
    printf '%s\n' "[STAGE 1] Creating directory structure..."
    for dir in /var/lib/apt/lists /var/lib/apt/lists/partial /var/cache/apt/archives /var/cache/apt/archives/partial /etc/apt/sources.list.d /etc/apt/trusted.gpg.d /etc/apt/preferences.d /etc/apt/apt.conf.d; do
        mkdir -p "${dir}" 2>/dev/null || true
        chmod 755 "${dir}" 2>/dev/null || true
        # CRITICAL: Ensure writability during build
        if [ -d "${dir}" ]; then
            # Test writability by creating a test file
            if touch "${dir}/.write_test_$$" 2>/dev/null; then
                rm -f "${dir}/.write_test_$$" 2>/dev/null || true
                printf '%s\n' "  ✓ ${dir} is writable"
            else
                printf '%s\n' "  ⚠ ${dir} may not be writable - attempting to fix..."
                # Try to fix ownership and permissions
                chown -R root:root "${dir}" 2>/dev/null || true
                chmod -R 755 "${dir}" 2>/dev/null || true
                # Test again
                if touch "${dir}/.write_test_$$" 2>/dev/null; then
                    rm -f "${dir}/.write_test_$$" 2>/dev/null || true
                    printf '%s\n' "  ✓ ${dir} is now writable (fixed)"
                else
                    printf '%s\n' "  ✗ ${dir} is NOT writable - this may cause APT failures during build"
                    exit 1
                fi
            fi
        fi
    done
    printf '%s\n' "  ✓ Directory structure created and verified writable"
    
    # Install procps-ng unconditionally
    printf '%s\n' "[STAGE 1] Installing procps-ng..."
    apt-get install -y --no-install-recommends procps 2>&1 || true
    apt-get install -y --no-install-recommends procps-ng 2>&1 || true
    printf '%s\n' "  ✓ procps-ng installation attempted"
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 2: TERMINAL COLORS AND CONTAINER SCRIPTS - ALL STEPS INCLUDED
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 2: Terminal Colors and Container Scripts${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Terminal color codes (already set above, but verify)
    printf '%s\n' "[STAGE 2] Verifying terminal color codes..."
    COLOR_VERIFY_FAILED=0
    for color_var in RED GREEN YELLOW BLUE NC; do
        if [ -z "${!color_var:-}" ]; then
            printf '%s\n' "  ✗ ${color_var} not defined"
            COLOR_VERIFY_FAILED=$((COLOR_VERIFY_FAILED + 1))
        fi
    done
    if [ ${COLOR_VERIFY_FAILED} -eq 0 ]; then
        printf '%s\n' "  ✓ All terminal color codes defined"
    fi
    
    # Container scripts installation
    printf '%s\n' "[STAGE 2] Installing container scripts..."
    CONTAINER_SCRIPTS_PATH="${CONTAINER_SCRIPTS_INSTALL_PATH:-/container-scripts}"
    INSTALLER_SCRIPT="${CONTAINER_SCRIPTS_PATH}/install.sh"
    
    if [ -d "${CONTAINER_SCRIPTS_PATH}" ] && [ -f "${INSTALLER_SCRIPT}" ]; then
        chmod +x "${INSTALLER_SCRIPT}" 2>/dev/null || true
        if "${INSTALLER_SCRIPT}" --all 2>&1; then
            printf '%s\n' "  ✓ Container scripts installed successfully"
        else
            printf '%s\n' "  ⚠ Container scripts installation had issues (may already be installed)"
        fi
    else
        printf '%s\n' "  ⚠ Container scripts directory not found (may be from %files section)"
    fi
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 3: INITIALIZATION BLOCKS - ALL STEPS INCLUDED
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 3: Initialization Blocks${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Phase tracking variables
    printf '%s\n' "[STAGE 3] Setting up phase tracking variables..."
    export PHASE1_STATUS="NOT RUN"
    export PHASE2_STATUS="NOT RUN"
    export PHASE3_STATUS="NOT RUN"
    export PHASE4_STATUS="NOT RUN"
    export PHASE5_STATUS="NOT RUN"
    printf '%s\n' "  ✓ Phase tracking variables set"
    
    # Environment setup
    printf '%s\n' "[STAGE 3] Setting up environment..."
    export DEBIAN_FRONTEND=noninteractive
    printf '%s\n' "  ✓ Environment setup complete"
    
    # Load common functions
    printf '%s\n' "[STAGE 3] Loading common functions..."
    if [ -f /scripts/common_functions.sh ]; then
        set +u
        source /scripts/common_functions.sh 2>/dev/null || true
        set -u
        if command -v calculate_build_jobs >/dev/null 2>&1; then
            BUILD_JOBS=$(calculate_build_jobs 2>&1 || echo "8")
            export BUILD_JOBS
            printf '%s\n' "  ✓ calculate_build_jobs() loaded (returns: ${BUILD_JOBS})"
        else
            printf '%s\n' "  ⚠ calculate_build_jobs() not available"
        fi
    else
        printf '%s\n' "  ⚠ common_functions.sh not found (will be loaded later)"
    fi
    
    # Define debug_glibc() function (from Stage 3)
    printf '%s\n' "[STAGE 3] Defining debug_glibc() function..."
    debug_glibc() {
        local stage="$1"
        local __prev_opts="$-"
        local __had_e=0
        case "$__prev_opts" in *e*) __had_e=1 ;; esac
        set +e
        set +o pipefail 2>/dev/null || true
        printf '%s\n' "=========================================================="
        printf '%b\n' "${BLUE}DEBUG CHECKPOINT: ${stage}${NC}"
        printf '%s\n' "Time: $(date)"
        printf '%s\n' "=========================================================="
        /lib/x86_64-linux-gnu/libc.so.6 2>/dev/null | head -1 2>/dev/null || true
        printf '%s\n' "---"
        (timeout 5 sh -c 'ldd --version 2>&1' || true) | head -1 || true
        printf '%s\n' "---"
        gcc --version 2>/dev/null | head -1 2>/dev/null || printf '%s\n' "GCC not installed yet" || true
        printf '%s\n' "---"
        find /usr/include -name "stdlib.h" 2>/dev/null || printf '%s\n' "stdlib.h not found"
        printf '%s\n' "---"
        printf '\033[0m\n'
        set -o pipefail 2>/dev/null || true
        if [ "$__had_e" -eq 1 ]; then
            set -e
        fi
    }
    export -f debug_glibc
    printf '%s\n' "  ✓ debug_glibc() function defined"
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 4: CACHE AND MIRROR FUNCTIONS - NEW STEPS
    # ============================================================================

    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 6: Package Management Functions${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Source package functions (from Stage 6)
    printf '%s\n' "[STAGE 6] Loading package functions..."
    if [ -f /scripts/package_functions.sh ]; then
        set +u
        source /scripts/package_functions.sh 2>/dev/null || true
        set -u
        if declare -f setup_conda_staging_area >/dev/null 2>&1 && \
           declare -f atomic_package_replace >/dev/null 2>&1 && \
           declare -f verify_package_integrity >/dev/null 2>&1 && \
           declare -f acquire_package_lock >/dev/null 2>&1 && \
           declare -f release_package_lock >/dev/null 2>&1; then
            printf '%s\n' "  ✓ package_functions.sh loaded successfully"
        else

    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 7: Main Build Execution Start${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # === BLOCK 8: MAIN BUILD EXECUTION START ===
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}BLOCK 8: Main Build Execution Start${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Sub-block 8.1: Initial diagnostic checkpoint
    printf '%s\n' "[BLOCK 8.1] Running initial diagnostic checkpoint..."
    if declare -f debug_glibc >/dev/null 2>&1; then
        debug_glibc "START - Before any apt operations"
        printf '%s\n' "  ✓ Initial diagnostic checkpoint completed"
    else
        printf '%s\n' "  ⚠ debug_glibc() not available (may be from previous stage)"
    fi
    printf '%s\n' ""
    
    # Sub-block 8.2: Create cache directory structure
    printf '%s\n' "[BLOCK 8.2] Creating cache directory structure..."
    CACHE_DIRS_CREATED=0
    CACHE_DIRS_FAILED=0
    
    # Create container cache directories
    for cache_dir in \
        "${CONTAINER_APT_CACHE:-${CONTAINER_CACHE_ROOT:-/container_cache}/apt/archives}" \
        "${CONTAINER_WHEELS_CACHE:-${CONTAINER_CACHE_ROOT:-/container_cache}/wheels}" \
        "${CONTAINER_CONDA_CACHE:-${CONTAINER_CACHE_ROOT:-/container_cache}/conda_pkgs}" \
        "${CONTAINER_JULIA_CACHE:-${CONTAINER_CACHE_ROOT:-/container_cache}/julia_pkgs}"; do
        if mkdir -p "${cache_dir}" 2>/dev/null; then
            chmod 755 "${cache_dir}" 2>/dev/null || true
            printf '%s\n' "  ✓ Created: ${cache_dir}"
            CACHE_DIRS_CREATED=$((CACHE_DIRS_CREATED + 1))
        else
            printf '%s\n' "  ✗ Failed to create: ${cache_dir}"
            CACHE_DIRS_FAILED=$((CACHE_DIRS_FAILED + 1))
        fi
    done
    
    # Create user-specific cache directories
    for user_cache_dir in /root/.cache/conda /root/.cache/julia /root/.local/share/julia; do
        if mkdir -p "${user_cache_dir}" 2>/dev/null; then
            chmod 755 "${user_cache_dir}" 2>/dev/null || true
            printf '%s\n' "  ✓ Created: ${user_cache_dir}"
            CACHE_DIRS_CREATED=$((CACHE_DIRS_CREATED + 1))
        else
            printf '%s\n' "  ✗ Failed to create: ${user_cache_dir}"
            CACHE_DIRS_FAILED=$((CACHE_DIRS_FAILED + 1))
        fi
    done
    
    if [ ${CACHE_DIRS_FAILED} -gt 0 ]; then
        printf '%s\n' "  ✗ ${CACHE_DIRS_FAILED} cache directory(ies) failed to create"
        exit 1
    else
        printf '%s\n' "  ✓ All ${CACHE_DIRS_CREATED} cache directories created successfully"
    fi
    printf '%s\n' ""
    
    # Sub-block 8.3: Verify ensure_directory_writable() function is available
    printf '%s\n' "[BLOCK 8.3] Verifying ensure_directory_writable() function..."
    if [ -f /scripts/common_functions.sh ]; then
        set +u
        source /scripts/common_functions.sh 2>/dev/null || true
        set -u
        if declare -f ensure_directory_writable >/dev/null 2>&1; then
            printf '%s\n' "  ✓ ensure_directory_writable() is available (from common_functions.sh)"
        else
            printf '%s\n' "  ✗ ensure_directory_writable() is NOT available"
            exit 1
        fi
    else
        printf '%s\n' "  ✗ common_functions.sh not found"
        exit 1
    fi
    printf '%s\n' ""
    
    # Sub-block 8.4: Systematic writability enforcement for all system directories
    printf '%s\n' "[BLOCK 8.4] Systematically ensuring all system directories are writable..."
    WRITABILITY_FAILED=0
    
    # APT-related directories (critical for package management)
    printf '%s\n' "  Verifying APT directories..."
    for apt_dir in \
        "/var/lib/apt/lists" \
        "/var/lib/apt/lists/partial" \
        "/var/cache/apt/archives" \
        "/var/cache/apt/archives/partial" \
        "/etc/apt/sources.list.d" \
        "/etc/apt/trusted.gpg.d" \
        "/etc/apt/preferences.d"; do
        if ensure_directory_writable "${apt_dir}" "APT directory: ${apt_dir}" >/dev/null 2>&1; then
            printf '%s\n' "  ✓ ${apt_dir} is writable"
        else
            printf '%s\n' "  ✗ ${apt_dir} is NOT writable"
            WRITABILITY_FAILED=$((WRITABILITY_FAILED + 1))
        fi
    done
    
    # Library and system configuration directories
    printf '%s\n' "  Verifying library and system directories..."
    for sys_dir in \
        "/etc/ld.so.conf.d" \
        "/usr/local/bin" \
        "/usr/local/lib" \
        "/usr/local/lib64" \
        "/usr/local/share" \
        "/usr/local/include"; do
        if ensure_directory_writable "${sys_dir}" "System directory: ${sys_dir}" >/dev/null 2>&1; then
            printf '%s\n' "  ✓ ${sys_dir} is writable"
        else
            printf '%s\n' "  ✗ ${sys_dir} is NOT writable"
            WRITABILITY_FAILED=$((WRITABILITY_FAILED + 1))
        fi
    done
    
    # Installation prefix directory
    printf '%s\n' "  Verifying installation prefix..."
    INSTALL_PREFIX="${INSTALL_PREFIX:-/opt}"
    if ensure_directory_writable "${INSTALL_PREFIX}" "Installation prefix: ${INSTALL_PREFIX}" >/dev/null 2>&1; then
        printf '%s\n' "  ✓ ${INSTALL_PREFIX} is writable"
        # Create common subdirectories
        for subdir in "${INSTALL_PREFIX}/bin" "${INSTALL_PREFIX}/lib" "${INSTALL_PREFIX}/lib64" "${INSTALL_PREFIX}/include" "${INSTALL_PREFIX}/share"; do
            if ensure_directory_writable "${subdir}" "Installation subdirectory: ${subdir}" >/dev/null 2>&1; then
                printf '%s\n' "  ✓ ${subdir} is writable"
            else
                printf '%s\n' "  ⚠ ${subdir} may not be writable (non-critical)"
            fi
        done
    else
        printf '%s\n' "  ✗ ${INSTALL_PREFIX} is NOT writable"
        WRITABILITY_FAILED=$((WRITABILITY_FAILED + 1))
    fi
    
    if [ ${WRITABILITY_FAILED} -gt 0 ]; then
        printf '%s\n' "  ✗ ${WRITABILITY_FAILED} directory(ies) are NOT writable - build may fail"
        exit 1
    else
        printf '%s\n' "  ✓ All system directories verified writable"
    fi
    printf '%s\n' ""
    
    # Sub-block 8.5: Cache validation and repair (verify function is available)
    printf '%s\n' "[BLOCK 8.5] Verifying validate_and_repair_cache() function..."
    if [ -f /scripts/cache_functions.sh ]; then
        set +u
        source /scripts/cache_functions.sh 2>/dev/null || true
        set -u
        if declare -f validate_and_repair_cache >/dev/null 2>&1; then
            printf '%s\n' "  ✓ validate_and_repair_cache() is available (from cache_functions.sh)"
            printf '%s\n' "  Executing validate_and_repair_cache()..."
            if validate_and_repair_cache >/dev/null 2>&1; then
                printf '%s\n' "  ✓ validate_and_repair_cache() executed successfully"
            else
                printf '%s\n' "  ⚠ validate_and_repair_cache() had issues (non-critical)"
            fi
        else
            printf '%s\n' "  ⚠ validate_and_repair_cache() is NOT available (may be from previous stage)"
        fi
    else
        printf '%s\n' "  ⚠ cache_functions.sh not found (will be loaded later)"
    fi
    printf '%s\n' ""
    
    # Sub-block 8.6: Test write permissions
    printf '%s\n' "[BLOCK 8.6] Testing write permissions..."
    TEST_FILE="/root/.cache/write_test"
    if [ -d /root/.cache ] && [ -w /root/.cache ]; then
        if touch "${TEST_FILE}" 2>/dev/null; then
            if [ -f "${TEST_FILE}" ] && rm -f "${TEST_FILE}" 2>/dev/null; then
                printf '%s\n' "  ✓ Write permissions verified in /root/.cache"
            else
                printf '%s\n' "  ⚠ Failed to remove test file (non-critical)"
            fi
        else
            printf '%s\n' "  ⚠ Write permissions issue detected in /root/.cache (non-critical)"
        fi
    else
        printf '%s\n' "  ⚠ /root/.cache directory not writable (non-critical)"
    fi
    printf '%s\n' ""
    
    # Sub-block 8.7: GPG verification functions (placeholder)
    printf '%s\n' "[BLOCK 8.7] Setting up GPG verification (placeholder)..."
    setup_gpg_verification() {
        printf '%s\n' "==> Setting up GPG verification for .deb packages..."
        # TODO: Implement GPG key import and verification setup
        # This function is a placeholder for future GPG verification functionality
        return 0
    }
    export -f setup_gpg_verification
    if setup_gpg_verification >/dev/null 2>&1; then
        printf '%s\n' "  ✓ GPG verification placeholder function created"
    else
        printf '%s\n' "  ⚠ GPG verification placeholder function had issues (non-critical)"
    fi
    printf '%s\n' ""
    
    # ============================================================================
    # STAGE 9: APT-ARIA WRAPPER SETUP - NEW STEPS
    # Purpose: Setup apt-aria wrapper for accelerated downloads with aria2
    # Dependencies: Stage 8 (mirror selection and APT setup), aria2
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}STAGE 9: APT-ARIA Wrapper Setup${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # ============================================================================
    # BLOCK 11: APT-ARIA WRAPPER SETUP (MUST BE BEFORE NVIDIA!)
    # ============================================================================
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}BLOCK 11: APT-ARIA Wrapper Setup${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Sub-block 11.1: Create APT tool aliasing wrapper
    printf '%s\n' "[BLOCK 11.1] Setting up APT tool aliasing for unified caching..."
    
    # Verify /usr/local/bin directory exists
    if ! install -d -m 0755 /usr/local/bin 2>/dev/null; then
        printf '%s\n' "  [ERROR] ⚠ Failed to create /usr/local/bin directory"
        exit 1
    fi
    
    # Verify apt-aria wrapper is installed (from %files section)
    printf '%s\n' "[BLOCK 11.1] Verifying apt-aria wrapper..."
    if [ ! -f /usr/local/bin/apt-aria ]; then
        printf '%s\n' "  [ERROR] ⚠ apt-aria wrapper file not found after installation"
        exit 1
    fi
    
    if ! chmod 0755 /usr/local/bin/apt-aria 2>/dev/null; then
        printf '%s\n' "  [ERROR] ⚠ Failed to set permissions on apt-aria wrapper"
        exit 1
    fi
    
    if [ ! -x /usr/local/bin/apt-aria ]; then
        printf '%s\n' "  [ERROR] ⚠ apt-aria wrapper is not executable after chmod"
        exit 1
    fi
    printf '%s\n' "  ✓ apt-aria wrapper verified"
    
    # Verify container-cache.sh is installed (from %files section)
    printf '%s\n' "[BLOCK 11.1] Verifying container-cache.sh..."
    if [ ! -f /etc/profile.d/container-cache.sh ]; then
        printf '%s\n' "  [ERROR] ⚠ container-cache.sh file not found after installation"
        exit 1
    fi
    
    if ! chmod 0644 /etc/profile.d/container-cache.sh 2>/dev/null; then
        printf '%s\n' "  [ERROR] ⚠ Failed to set permissions on container-cache.sh"
        exit 1
    fi
    printf '%s\n' "  ✓ Container cache environment setup verified"
    
    # Add CONTAINER_APT_CACHE to /etc/environment
    printf '%s\n' "[BLOCK 11.1] Adding CONTAINER_APT_CACHE to /etc/environment..."
    if [ -f /etc/environment ] && [ -w /etc/environment ]; then
        env_content=$(cat /etc/environment 2>/dev/null || echo "")
        if [ -z "${env_content:-}" ] || ! grep -q "^CONTAINER_APT_CACHE=" <<< "${env_content}"; then
            if ! echo "CONTAINER_APT_CACHE=${CONTAINER_APT_CACHE:-/container_cache/apt/archives}" >> /etc/environment 2>/dev/null; then
                printf '%s\n' "  [warn] ⚠ Failed to append to /etc/environment"
            else
                printf '%s\n' "  ✓ CONTAINER_APT_CACHE added to /etc/environment"
            fi
        else
            printf '%s\n' "  ✓ CONTAINER_APT_CACHE already in /etc/environment"
        fi
    else
        printf '%s\n' "  [warn] ⚠ /etc/environment not writable - skipping environment variable addition"
    fi
    
    # Monitor cache after apt-aria setup
    if [ -f /scripts/common_functions.sh ]; then
        set +u
        source /scripts/common_functions.sh 2>/dev/null || true
        set -u
        if declare -f monitor_cache >/dev/null 2>&1; then
            monitor_cache "After apt-aria wrapper setup" >/dev/null 2>&1 || true
        fi
    fi
    printf '%s\n' ""
    
    # Sub-block 11.2: Create APT tool symlinks for consistent caching
    printf '%s\n' "[BLOCK 11.2] Creating APT tool symlinks for consistent caching..."
    if [ -d /usr/local/bin ] && [ -w /usr/local/bin ]; then
        if ! ln -sf /usr/local/bin/apt-aria /usr/local/bin/apt-get 2>/dev/null; then
            printf '%s\n' "  [ERROR] ⚠ Failed to create apt-get symlink"
            exit 1
        fi
        if [ ! -L /usr/local/bin/apt-get ]; then
            printf '%s\n' "  [ERROR] ⚠ apt-get symlink not found after creation"
            exit 1
        fi
        printf '%s\n' "  ✓ apt-get symlink created"
        
        if ! ln -sf /usr/local/bin/apt-aria /usr/local/bin/apt 2>/dev/null; then
            printf '%s\n' "  [ERROR] ⚠ Failed to create apt symlink"
            exit 1
        fi
        if [ ! -L /usr/local/bin/apt ]; then
            printf '%s\n' "  [ERROR] ⚠ apt symlink not found after creation"
            exit 1
        fi
        printf '%s\n' "  ✓ apt symlink created"
    else
        printf '%s\n' "  [ERROR] ⚠ /usr/local/bin directory not writable - cannot create symlinks"
        exit 1
    fi
    printf '%s\n' ""
    
    # Sub-block 11.3: Verify APT aliasing
    printf '%s\n' "[BLOCK 11.3] Verifying APT tool aliasing..."
    apt_get_link=$(readlink -f /usr/local/bin/apt-get 2>/dev/null || echo 'Not aliased')
    apt_link=$(readlink -f /usr/local/bin/apt 2>/dev/null || echo 'Not aliased')
    if [ -z "${apt_get_link:-}" ]; then
        apt_get_link='Not aliased'
    fi
    if [ -z "${apt_link:-}" ]; then
        apt_link='Not aliased'
    fi
    printf '%s\n' "  apt-get -> ${apt_get_link}"
    printf '%s\n' "  apt -> ${apt_link}"
    printf '%s\n' "  ✓ APT-aria wrapper and symlinks configured successfully"
    printf '%s\n' "  ✓ ALL subsequent apt-get/apt commands will use aria2 acceleration + caching"
    
    # Verify PATH order to ensure /usr/local/bin precedes /usr/bin
    path_value="${PATH:-}"
    if [ -n "${path_value}" ]; then
        first_local=$(awk -v RS=':' '/\/usr\/local\/bin/{print NR; exit}' <<< "${path_value}" 2>/dev/null || echo "")
        first_usr=$(awk -v RS=':' '/\/usr\/bin/{print NR; exit}' <<< "${path_value}" 2>/dev/null || echo "")
        if [ -n "${first_local}" ] && [ -n "${first_usr}" ] && [[ "${first_local}" =~ ^[0-9]+$ ]] && [[ "${first_usr}" =~ ^[0-9]+$ ]]; then
            if [ "${first_local}" -gt "${first_usr}" ]; then
                printf '%s\n' "  [warn] ⚠ PATH order may overshadow apt-aria: /usr/bin appears before /usr/local/bin"
                printf '%s\n' "         Current PATH: ${path_value}"
                printf '%s\n' "         Consider exporting PATH with /usr/local/bin before /usr/bin to ensure apt-aria is used."
            else
                printf '%s\n' "  ✓ PATH order confirmed: /usr/local/bin precedes /usr/bin (apt-aria active)"
            fi
        else
            printf '%s\n' "  ✓ PATH order verification skipped (could not parse PATH)"
        fi
    fi
    printf '%s\n' ""
    
    # Verify aria2 is installed (required for apt-aria to work)
    printf '%s\n' "[BLOCK 11] Verifying aria2 is installed..."
    if ! command -v aria2c >/dev/null 2>&1; then
        printf '%s\n' "  [warn] ⚠ aria2 not found - installing..."
        apt-get update -qq >/dev/null 2>&1 || true
        if ! apt-get install -y --no-install-recommends aria2 >/dev/null 2>&1; then
            printf '%s\n' "  [ERROR] ⚠ Failed to install aria2"
            exit 1
        fi
        if ! command -v aria2c >/dev/null 2>&1; then
            printf '%s\n' "  [ERROR] ⚠ aria2 installation succeeded but command not found"
            exit 1
        fi
        printf '%s\n' "  ✓ aria2 installed"
    else
        printf '%s\n' "  ✓ aria2 is available"
    fi
    printf '%s\n' ""
    
    # === FINAL SUMMARY ===
    printf '%s\n' "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${GREEN}STAGE 9 COMPLETE${NC}"
    printf '%s\n' "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # === CREATE RUNTIME INITIALIZATION SCRIPT ===
    # Purpose: Source function scripts and define functions at runtime
    # This script will be sourced automatically by bash when container starts
    printf '%s\n' "[RUNTIME INIT] Creating runtime initialization script..."
    mkdir -p /etc/profile.d
    {
        echo "#!/bin/bash"
        echo "# Runtime initialization script for Stage 9"
        echo "# This script sources all function scripts and defines functions"
        echo ""
        echo "# Source function scripts (from Stages 3, 4, 5, 6, 7, and 8)"
        echo "if [ -f /scripts/common_functions.sh ]; then"
        echo "    . /scripts/common_functions.sh 2>/dev/null || true"
        echo "fi"
        echo "if [ -f /scripts/mirror_functions.sh ]; then"
        echo "    . /scripts/mirror_functions.sh 2>/dev/null || true"
        echo "fi"
        echo "if [ -f /scripts/library_functions.sh ]; then"
        echo "    . /scripts/library_functions.sh 2>/dev/null || true"
        echo "fi"
        echo "if [ -f /scripts/cache_functions.sh ]; then"
        echo "    . /scripts/cache_functions.sh 2>/dev/null || true"
        echo "fi"
        echo "if [ -f /scripts/package_functions.sh ]; then"
        echo "    . /scripts/package_functions.sh 2>/dev/null || true"
        echo "fi"
        echo ""
        echo "# Source container-cache.sh (from Stage 9)"
        echo "if [ -f /etc/profile.d/container-cache.sh ]; then"
        echo "    . /etc/profile.d/container-cache.sh 2>/dev/null || true"
        echo "fi"
        echo ""
        echo "# Define debug_glibc() function (from Stage 3)"
        echo "debug_glibc() {"
        echo "    local stage=\"\${1:-unknown}\""
        echo "    local __prev_opts=\"\$-\""
        echo "    local __had_e=0"
        echo "    case \"\$__prev_opts\" in *e*) __had_e=1 ;; esac"
        echo "    set +e"
        echo "    set +o pipefail 2>/dev/null || true"
        echo "    printf '%s\\n' '=========================================================='"
        echo "    printf '%b\\n' \"\${BLUE}DEBUG CHECKPOINT: \${stage}\${NC}\""
        echo "    printf '%s\\n' \"Time: \$(date)\""
        echo "    printf '%s\\n' '=========================================================='"
        echo "    /lib/x86_64-linux-gnu/libc.so.6 2>/dev/null | head -1 2>/dev/null || true"
        echo "    printf '%s\\n' '---'"
        echo "    (timeout 5 sh -c 'ldd --version 2>&1' || true) | head -1 || true"
        echo "    printf '%s\\n' '---'"
        echo "    gcc --version 2>/dev/null | head -1 2>/dev/null || printf '%s\\n' 'GCC not installed yet' || true"
        echo "    printf '%s\\n' '---'"
        echo "    find /usr/include -name 'stdlib.h' 2>/dev/null || printf '%s\\n' 'stdlib.h not found'"
        echo "    printf '%s\\n' '---'"
        echo "    printf '\\033[0m\\n'"
        echo "    set -o pipefail 2>/dev/null || true"
        echo "    if [ \"\$__had_e\" -eq 1 ]; then"
        echo "        set -e"
        echo "    fi"
        echo "}"
        echo "export -f debug_glibc"
        echo ""
        echo "# Define setup_gpg_verification() function (from Stage 7)"
        echo "setup_gpg_verification() {"
        echo "    printf '%s\\n' '==> Setting up GPG verification for .deb packages...'"
        echo "    # TODO: Implement GPG key import and verification setup"
        echo "    return 0"
        echo "}"
        echo "export -f setup_gpg_verification"
        echo ""
        echo "# Export FASTEST_MIRROR variable (from Stage 8)"
        echo "if [ -n \"\${FASTEST_MIRROR:-}\" ]; then"
        echo "    export FASTEST_MIRROR"
        echo "fi"
        echo ""
        echo "# Define verify_deb_package() function (from Stage 8)"
        echo "verify_deb_package() {"
        echo "    local deb_file=\"\${1:-}\""
        echo "    local gpg_key_id=\"\${2:-}\""
        echo "    local basename_file"
        echo "    if [ -z \"\${deb_file}\" ] || [ -z \"\${gpg_key_id}\" ] || [ ! -f \"\${deb_file}\" ]; then"
        echo "        return 1"
        echo "    fi"
        echo "    basename_file=\$(basename \"\${deb_file}\" || echo \"\")"
        echo "    if ! dpkg-deb -I \"\${deb_file}\" >/dev/null 2>&1; then"
        echo "        return 1"
        echo "    fi"
        echo "    if command -v dpkg-sig >/dev/null 2>&1; then"
        echo "        if dpkg-sig --verify \"\${deb_file}\" >/dev/null 2>&1; then"
        echo "            return 0"
        echo "        fi"
        echo "    fi"
        echo "    return 0"
        echo "}"
        echo "export -f verify_deb_package"
    } > /etc/profile.d/stage9_init.sh
    chmod 644 /etc/profile.d/stage9_init.sh
    printf '%s\n' "  ✓ Runtime initialization script created: /etc/profile.d/stage9_init.sh"
    
    # Cleanup temporary files
    rm -rf /tmp/* /var/tmp/* 2>/dev/null || true


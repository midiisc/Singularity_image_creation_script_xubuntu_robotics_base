Bootstrap: docker
From: osrf/ros:jazzy-desktop-full-noble

# === %files Section ===
%files
    /home/midhun/Documents/Singularity_image_creation_script_xubuntu_robotics_base/config.sh /etc/config.sh
    /home/midhun/Documents/Singularity_image_creation_script_xubuntu_robotics_base/container-scripts /container-scripts

# === %labels Section ===
%labels
    Maintainer midhun
    Description "Progressive Stage 2: Terminal Colors and Block 0 (Container Scripts)"

# === %environment Section ===
%environment
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Asia/Kolkata
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# === %setup Section ===
%setup
    # Create mount point directories (using /container_cache as default - config.sh available in %post)
    mkdir -p ${APPTAINER_ROOTFS}/container_cache
    mkdir -p ${APPTAINER_ROOTFS}/tmp
    mkdir -p ${APPTAINER_ROOTFS}/var/tmp

# === %post Section ===
%post -c /bin/bash
    export DEBIAN_FRONTEND=noninteractive
    export DEBCONF_NONINTERACTIVE_SEEN=true
    export DEBCONF_NOWARNINGS=true
    
    # === CRITICAL: Source centralized configuration ===
    # config.sh is the SINGLE SOURCE OF TRUTH for all paths, versions, and settings
    # It is copied to /etc/config.sh in the %files section
    if [ -f /etc/config.sh ]; then
        # Disable strict mode temporarily to allow config.sh to set defaults
        set +u
        source /etc/config.sh
        set -u
        printf '%s\n' "[%post] ✓ Loaded centralized configuration from /etc/config.sh"
        printf '%s\n' "[%post]   CONTAINER_SCRIPTS_INSTALL_PATH: ${CONTAINER_SCRIPTS_INSTALL_PATH:-/container-scripts}"
        printf '%s\n' "[%post]   CONTAINER_CACHE_ROOT: ${CONTAINER_CACHE_ROOT:-/container_cache}"
    else
        printf '%s\n' "[%post] ⚠ WARNING: /etc/config.sh not found - using defaults"
        printf '%s\n' "[%post]   This should not happen - config.sh should be copied in %files section"
        # Set minimal defaults if config.sh missing
        export CONTAINER_SCRIPTS_INSTALL_PATH="${CONTAINER_SCRIPTS_INSTALL_PATH:-/container-scripts}"
        export CONTAINER_CACHE_ROOT="${CONTAINER_CACHE_ROOT:-/container_cache}"
    fi
    
    echo "=========================================="
    echo "PROGRESSIVE STAGE 2: Terminal Colors and Block 0"
    echo "=========================================="
    echo ""
    
    # === TERMINAL COLOR CODES ===
    # Purpose: Define color codes for terminal output (used throughout build)
    # Dependencies: None (foundational)
    # Outputs: Environment variables for colored output
    printf '%s\n' "[TERMINAL COLORS] Defining terminal color codes..."
    
    # Define color codes (matching build_xubuntu_robotics_base.sh and xubuntu_robotics_base_debug.sh)
    RED='\033[0;31m'      # Error messages
    GREEN='\033[0;32m'    # Success messages
    YELLOW='\033[1;33m'   # Warning messages
    BLUE='\033[0;34m'     # Info messages
    NC='\033[0m'          # No Color (reset)
    
    # Export colors for use in subprocesses
    export RED GREEN YELLOW BLUE NC
    
    # Verify colors are defined
    COLOR_VERIFY_FAILED=0
    for color_var in RED GREEN YELLOW BLUE NC; do
        if [ -z "${!color_var:-}" ]; then
            printf '%s\n' "  ✗ ${color_var} not defined"
            COLOR_VERIFY_FAILED=$((COLOR_VERIFY_FAILED + 1))
        else
            printf '%s\n' "  ✓ ${color_var} defined: ${!color_var}"
        fi
    done
    
    if [ ${COLOR_VERIFY_FAILED} -eq 0 ]; then
        printf '%s\n' "  ✓ All terminal color codes defined successfully"
    else
        printf '%s\n' "  ✗ ${COLOR_VERIFY_FAILED} color code(s) failed to define"
        exit 1
    fi
    
    printf '%s\n' ""
    
    # === BLOCK 0: INSTALL CONTAINER SCRIPTS ===
    # Purpose: Install all extracted scripts from container-scripts/ directory
    #          This must happen early so scripts are available throughout the build
    # Dependencies: container-scripts/ directory (copied in %files section)
    # Outputs: All scripts installed to their target locations
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' "${BLUE}BLOCK 0: Installing Container Scripts${NC}"
    printf '%s\n' "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    printf '%s\n' ""
    
    # Use variables from config.sh (SINGLE SOURCE OF TRUTH)
    # These are already set when config.sh was sourced above
    CONTAINER_SCRIPTS_PATH="${CONTAINER_SCRIPTS_INSTALL_PATH:-/container-scripts}"
    INSTALLER_SCRIPT="${CONTAINER_SCRIPTS_PATH}/${CONTAINER_SCRIPTS_INSTALLER:-install.sh}"
    MANIFEST_FILE="${CONTAINER_SCRIPTS_PATH}/${CONTAINER_SCRIPTS_MANIFEST:-MANIFEST.json}"
    
    printf '%s\n' "[INFO] Using container scripts configuration from config.sh:"
    printf '%s\n' "  CONTAINER_SCRIPTS_PATH: ${CONTAINER_SCRIPTS_PATH}"
    printf '%s\n' "  INSTALLER_SCRIPT: ${INSTALLER_SCRIPT}"
    printf '%s\n' "  MANIFEST_FILE: ${MANIFEST_FILE}"
    
    # Verify container-scripts directory exists
    printf '%s\n' "[VERIFY] Checking container-scripts directory..."
    if [ ! -d "${CONTAINER_SCRIPTS_PATH}" ]; then
        printf '%s\n' "${RED}✗ Container scripts directory not found: ${CONTAINER_SCRIPTS_PATH}${NC}"
        exit 1
    fi
    printf '%s\n' "${GREEN}✓ Container scripts directory exists: ${CONTAINER_SCRIPTS_PATH}${NC}"
    
    # Verify installer script exists
    if [ ! -f "${INSTALLER_SCRIPT}" ]; then
        printf '%s\n' "${RED}✗ Installer script not found: ${INSTALLER_SCRIPT}${NC}"
        exit 1
    fi
    printf '%s\n' "${GREEN}✓ Installer script exists: ${INSTALLER_SCRIPT}${NC}"
    
    # Verify manifest file exists
    if [ ! -f "${MANIFEST_FILE}" ]; then
        printf '%s\n' "${RED}✗ Manifest file not found: ${MANIFEST_FILE}${NC}"
        exit 1
    fi
    printf '%s\n' "${GREEN}✓ Manifest file exists: ${MANIFEST_FILE}${NC}"
    
    # Set executable permissions on installer script
    if ! chmod +x "${INSTALLER_SCRIPT}" 2>/dev/null; then
        printf '%s\n' "${YELLOW}⚠ Warning: Failed to set executable permissions on installer script${NC}"
    else
        printf '%s\n' "${GREEN}✓ Installer script is executable${NC}"
    fi
    
    # Verify installer script is executable
    if [ ! -x "${INSTALLER_SCRIPT}" ]; then
        printf '%s\n' "${RED}✗ Installer script is not executable: ${INSTALLER_SCRIPT}${NC}"
        exit 1
    fi
    
    printf '%s\n' ""
    printf '%s\n' "[INSTALL] Running container scripts installation..."
    
    # Run installer script
    if "${INSTALLER_SCRIPT}" --all; then
        printf '%s\n' "${GREEN}✓ Container scripts installed successfully${NC}"
    else
        INSTALL_EXIT_CODE=$?
        printf '%s\n' "${RED}✗ Container scripts installation failed (exit code: ${INSTALL_EXIT_CODE})${NC}"
        exit 1
    fi
    
    printf '%s\n' ""
    
    # === VERIFY CONTAINER SCRIPTS INSTALLATION ===
    # Purpose: Verify that key scripts were installed correctly
    # Dependencies: BLOCK 0 (container scripts installation)
    # Outputs: Verification results
    printf '%s\n' "[VERIFY] Verifying container scripts installation..."
    
    SCRIPT_VERIFY_FAILED=0
    
    # Check for key verification tools (from MANIFEST.json block 0)
    KEY_SCRIPTS=(
        "/usr/local/bin/verify-mkl-env.sh"
        "/usr/local/bin/verify-cuda-mkl-linkage.sh"
        "/usr/local/bin/verify-python-mkl.sh"
    )
    
    for script_path in "${KEY_SCRIPTS[@]}"; do
        if [ -f "${script_path}" ]; then
            # Check if executable
            if [ -x "${script_path}" ]; then
                SCRIPT_PERMS=$(stat -c '%a' "${script_path}" 2>/dev/null || printf '%s\n' "unknown")
                printf '%s\n' "${GREEN}✓ ${script_path} exists and is executable (perms: ${SCRIPT_PERMS})${NC}"
            else
                printf '%s\n' "${YELLOW}⚠ ${script_path} exists but is not executable${NC}"
                # Try to fix permissions
                if chmod +x "${script_path}" 2>/dev/null; then
                    printf '%s\n' "${GREEN}✓ Fixed permissions on ${script_path}${NC}"
                else
                    printf '%s\n' "${RED}✗ Failed to fix permissions on ${script_path}${NC}"
                    SCRIPT_VERIFY_FAILED=$((SCRIPT_VERIFY_FAILED + 1))
                fi
            fi
        else
            printf '%s\n' "${YELLOW}⚠ ${script_path} not found (may be optional)${NC}"
        fi
    done
    
    # Count total installed scripts from manifest
    if command -v jq >/dev/null 2>&1 && [ -f "${MANIFEST_FILE}" ]; then
        TOTAL_SCRIPTS=$(jq '.files | length' "${MANIFEST_FILE}" 2>/dev/null || printf '%s\n' "0")
        printf '%s\n' "${GREEN}✓ Total scripts in manifest: ${TOTAL_SCRIPTS}${NC}"
    else
        printf '%s\n' "${YELLOW}⚠ jq not available - cannot count total scripts${NC}"
    fi
    
    # Verify container-scripts directory structure
    printf '%s\n' ""
    printf '%s\n' "[VERIFY] Verifying container-scripts directory structure..."
    
    REQUIRED_SUBDIRS=(
        "shell-scripts"
        "config-files"
        "verification-tools"
    )
    
    for subdir in "${REQUIRED_SUBDIRS[@]}"; do
        if [ -d "${CONTAINER_SCRIPTS_PATH}/${subdir}" ]; then
            printf '%s\n' "${GREEN}✓ ${subdir}/ directory exists${NC}"
        else
            printf '%s\n' "${YELLOW}⚠ ${subdir}/ directory not found (may be normal)${NC}"
        fi
    done
    
    # Final verification summary
    printf '%s\n' ""
    printf '%s\n' "[VERIFY] Container scripts installation verification summary:"
    if [ ${SCRIPT_VERIFY_FAILED} -eq 0 ]; then
        printf '%s\n' "${GREEN}✓ All container scripts verification checks passed${NC}"
    else
        printf '%s\n' "${RED}✗ ${SCRIPT_VERIFY_FAILED} container scripts verification(s) failed${NC}"
        printf '%s\n' "${YELLOW}⚠ Build will continue but some scripts may not be available${NC}"
    fi
    
    printf '%s\n' ""
    
    # === APT WRITABILITY VERIFICATION (MANDATORY AFTER EACH STAGE) ===
    # Purpose: Verify APT operations will work correctly in subsequent stages
    # Dependencies: verify_permissions.sh (sourced by build_stage.sh)
    # Note: This is also run automatically by build_stage.sh, but we include it here
    #       for completeness and early detection of issues
    # CRITICAL: Also verify container_cache is configured for APT (pre-population awareness)
    printf '%s\n' "[APT WRITABILITY] Verifying APT writability and container_cache configuration..."
    
    APT_VERIFY_FAILED=0
    
    # Quick APT writability check
    APT_PATHS=(
        "/var/lib/apt/lists"
        "/var/cache/apt/archives"
        "/etc/apt/sources.list.d"
        "/etc/apt/trusted.gpg.d"
    )
    
    for apt_path in "${APT_PATHS[@]}"; do
        if [ -d "${apt_path}" ]; then
            TEST_FILE="${apt_path}/.apt_test_$$"
            if touch "${TEST_FILE}" 2>/dev/null && rm -f "${TEST_FILE}" 2>/dev/null; then
                printf '%s\n' "${GREEN}✓ ${apt_path} is writable${NC}"
            else
                printf '%s\n' "${RED}✗ ${apt_path} is NOT writable${NC}"
                APT_VERIFY_FAILED=$((APT_VERIFY_FAILED + 1))
            fi
        else
            printf '%s\n' "${YELLOW}⚠ ${apt_path} does not exist${NC}"
        fi
    done
    
    # Verify container_cache is configured for APT (pre-population awareness)
    CONTAINER_CACHE_ROOT="${CONTAINER_CACHE_ROOT:-/container_cache}"
    CONTAINER_APT_CACHE="${CONTAINER_APT_CACHE:-${CONTAINER_CACHE_ROOT}/apt/archives}"
    
    if [ -d "${CONTAINER_APT_CACHE}" ]; then
        # Check if APT is configured to use container_cache
        if [ -f /etc/apt/apt.conf.d/01-robustness ]; then
            CONFIGURED_CACHE=$(grep "Dir::Cache::Archives" /etc/apt/apt.conf.d/01-robustness | sed 's/.*"\(.*\)".*/\1/' 2>/dev/null || printf '%s\n' "")
            if [ -n "${CONFIGURED_CACHE}" ] && [ "${CONFIGURED_CACHE}" = "${CONTAINER_APT_CACHE}" ]; then
                printf '%s\n' "${GREEN}✓ APT configured to use container_cache: ${CONTAINER_APT_CACHE}${NC}"
                
                # Check for pre-populated packages (container_cache awareness)
                CACHED_PACKAGES=$(find "${CONTAINER_APT_CACHE}" -name "*.deb" 2>/dev/null | wc -l || printf '%s\n' "0")
                if [ "${CACHED_PACKAGES}" -gt 0 ]; then
                    printf '%s\n' "${GREEN}✓ Found ${CACHED_PACKAGES} pre-populated package(s) in container_cache${NC}"
                    printf '%s\n' "${GREEN}✓ Container cache pre-population working - packages will be reused${NC}"
                else
                    printf '%s\n' "${YELLOW}⚠ No packages cached yet (normal for first build)${NC}"
                    printf '%s\n' "${YELLOW}⚠ Packages will be cached here for reuse in later builds${NC}"
                fi
            else
                printf '%s\n' "${YELLOW}⚠ APT cache configuration may be incorrect: ${CONFIGURED_CACHE}${NC}"
            fi
        else
            printf '%s\n' "${YELLOW}⚠ APT robustness configuration not found (may be from earlier stage)${NC}"
        fi
    else
        printf '%s\n' "${YELLOW}⚠ Container APT cache directory does not exist: ${CONTAINER_APT_CACHE}${NC}"
    fi
    
    if [ ${APT_VERIFY_FAILED} -eq 0 ]; then
        printf '%s\n' "${GREEN}✓ APT writability verification passed${NC}"
    else
        printf '%s\n' "${RED}✗ ${APT_VERIFY_FAILED} APT writability check(s) failed${NC}"
    fi
    
    printf '%s\n' ""
    
    # === CLEANUP ===
    printf '%s\n' "[CLEANUP] Cleaning up temporary files..."
    
    # Clean test files (using CONTAINER_CACHE_ROOT from config.sh)
    CONTAINER_CACHE_ROOT="${CONTAINER_CACHE_ROOT:-/container_cache}"
    for test_path in /tmp /var/tmp "${CONTAINER_CACHE_ROOT}"; do
        if [ -d "${test_path}" ]; then
            find "${test_path}" -maxdepth 1 -type f \( -name ".apt_test_*" -o -name ".write_test_*" -o -name ".test_*" \) 2>/dev/null | while IFS= read -r test_file || [ -n "${test_file}" ]; do
                rm -f "${test_file}" 2>/dev/null || true
            done
        fi
    done
    
    # Clean APT cache
    if command -v apt-get >/dev/null 2>&1; then
        apt-get clean >/dev/null 2>&1 || true
        apt-get autoclean >/dev/null 2>&1 || true
    fi
    
    printf '%s\n' "${GREEN}✓ Cleanup complete${NC}"
    printf '%s\n' ""
    printf '%s\n' "=========================================="
    printf '%s\n' "Stage 2 complete."
    printf '%s\n' "=========================================="


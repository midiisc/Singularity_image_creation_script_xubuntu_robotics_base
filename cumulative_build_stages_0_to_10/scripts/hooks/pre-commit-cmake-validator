#!/bin/bash
################################################################################
# PRE-COMMIT HOOK: CMAKE FLAG VALIDATOR
# Purpose: Validate CMake flags before committing build script changes
# Installation: 
#   ln -s ../../scripts/hooks/pre-commit-cmake-validator .git/hooks/pre-commit
#
# Implements: prompts/Code_check_prompt_manual.txt (Master entry point - loads all parts sequentially)
# Section M8/M9/M10 in PART3 (M. Environment & Dependencies)
################################################################################

set -euo pipefail

# Configuration
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
WORKSPACE_ROOT=$(cd "${SCRIPT_DIR}/../.." 2>/dev/null && pwd || cd "${SCRIPT_DIR}" && pwd)
VALIDATOR="${WORKSPACE_ROOT}/scripts/helpers/validate_cmake_flags.sh"

# Build scripts to check
BUILD_SCRIPTS=(
  "xubuntu_robotics_base_full.sh"
  "build_xubuntu_robotics_base.sh"
)

# Color codes
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}    PRE-COMMIT: CMAKE FLAG VALIDATION${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Check if validator exists
if [ ! -f "$VALIDATOR" ]; then
  echo -e "${YELLOW}[⚠] CMAKE flag validator not found: ${VALIDATOR}${NC}"
  echo -e "${YELLOW}[⚠] Skipping validation (please install validator)${NC}"
  exit 0
fi

# Check if validator is executable
if [ ! -x "$VALIDATOR" ]; then
  chmod +x "$VALIDATOR"
fi

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if any build scripts are being committed
SCRIPTS_TO_VALIDATE=()
for script in "${BUILD_SCRIPTS[@]}"; do
  if echo "$STAGED_FILES" | grep -q "^${script}$"; then
    SCRIPTS_TO_VALIDATE+=("${WORKSPACE_ROOT}/${script}")
  fi
done

# If no build scripts staged, skip validation
if [ ${#SCRIPTS_TO_VALIDATE[@]} -eq 0 ]; then
  echo -e "${GREEN}[✓]${NC} No build scripts staged for commit"
  echo -e "${GREEN}[✓]${NC} Skipping CMake flag validation"
  echo ""
  exit 0
fi

# Validate each staged build script
VALIDATION_FAILED=false
for script in "${SCRIPTS_TO_VALIDATE[@]}"; do
  echo -e "${BLUE}[→]${NC} Validating: ${script##*/}"
  echo ""
  
  if ! "$VALIDATOR" "$script" --strict; then
    VALIDATION_FAILED=true
    echo ""
    echo -e "${RED}[✗]${NC} Validation failed for: ${script##*/}"
    echo ""
  else
    echo -e "${GREEN}[✓]${NC} Validation passed for: ${script##*/}"
    echo ""
  fi
done

# Final verdict
if [ "$VALIDATION_FAILED" = true ]; then
  echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${RED}    COMMIT BLOCKED: Invalid CMake Flags Detected${NC}"
  echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo ""
  echo -e "${YELLOW}REQUIRED ACTIONS:${NC}"
  echo "  1. Review validation errors above"
  echo "  2. Fix invalid/undocumented flags in build scripts"
  echo "  3. Update flags to match docs/flags/*.md documentation"
  echo "  4. Re-run 'git commit' after fixes"
  echo ""
  echo -e "${YELLOW}TO BYPASS (NOT RECOMMENDED):${NC}"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}    ✓ CMAKE FLAG VALIDATION PASSED${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
exit 0
